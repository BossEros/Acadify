@model ASI.Basecode.Services.DTOs.UserManagementDto
@{
    ViewData["Title"] = "User Details";
}

<div class="max-w-4xl mx-auto bg-white p-6 rounded shadow">
    <h2 class="text-xl font-semibold mb-4">User Details</h2>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="space-y-4">
            <div>
                <label class="block font-medium text-gray-700">User ID:</label>
                <p class="text-gray-900">@Model.Id</p>
            </div>

            <div>
                <label class="block font-medium text-gray-700">Username:</label>
                <p class="text-gray-900">@Model.UserName</p>
            </div>

            <div>
                <label class="block font-medium text-gray-700">Name:</label>
                <p class="text-gray-900">@Model.FullName</p>
            </div>

            <div>
                <label class="block font-medium text-gray-700">Email:</label>
                <p class="text-gray-900">@Model.Email</p>
            </div>
        </div>

        <div class="space-y-4">
            <div>
                <label class="block font-medium text-gray-700">Role:</label>
                @{
                    var color = Model.Role switch
                    {
                        "Admin" => "bg-yellow-100 text-yellow-700",
                        "Teacher" => "bg-green-100 text-green-700",
                        "Student" => "bg-blue-100 text-blue-700",
                        _ => "bg-gray-100 text-gray-700"
                    };
                }
                <span class="px-3 py-1 rounded text-sm font-medium @color">@Model.Role</span>
            </div>

            <div>
                <label class="block font-medium text-gray-700">Status:</label>
                @if (Model.IsActive)
                {
                    <span class="text-green-600 font-medium">Active</span>
                }
                else
                {
                    <span class="text-red-600 font-medium">Inactive</span>
                }
            </div>

            <div>
                <label class="block font-medium text-gray-700">Created At:</label>
                <p class="text-gray-900">@Model.CreatedAt.ToString("MMM dd, yyyy HH:mm")</p>
            </div>
        </div>
    </div>

    <div class="mt-6 flex space-x-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" 
           class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded">
            Edit User
        </a>
        
        <a asp-action="ChangePassword" asp-route-id="@Model.Id" 
           class="bg-green-600 hover:bg-green-700 text-white px-4 py-2 rounded">
            Change Password
        </a>
        
        @if (!Model.Role.Equals("Admin", StringComparison.OrdinalIgnoreCase))
        {
            <a asp-action="Delete" asp-route-id="@Model.Id" 
               class="bg-red-600 hover:bg-red-700 text-white px-4 py-2 rounded">
                Delete User
            </a>
        }
        
        <a asp-action="Index" class="bg-gray-500 hover:bg-gray-600 text-white px-4 py-2 rounded">
            Back to List
        </a>
    </div>
</div>
