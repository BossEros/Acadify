@model ASI.Basecode.WebApp.ViewModels.AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "_AdminLayout";
}

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<div class="container mx-auto px-4 py-8">
    <h1 class="text-3xl font-bold text-gray-800 mb-8">Dashboard Overview</h1>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        
        <div class="bg-white rounded-lg shadow p-6">
            <div class="flex justify-between items-start mb-4">
                <div>
                    <h3 class="text-lg font-semibold text-gray-700">User Statistics</h3>
                    <p class="text-sm text-gray-500">Total Users: <span class="font-bold text-gray-800">@Model.TotalUsers</span></p>
                </div>
            </div>
            
            <div class="flex items-center">
                <div class="w-1/2 h-48">
                    <canvas id="userChart"></canvas>
                </div>
                
                <div class="w-1/2 pl-6 space-y-3">
                    <div class="flex justify-between items-center">
                        <div class="flex items-center">
                            <span class="w-3 h-3 rounded-full bg-blue-500 mr-2"></span>
                            <span class="text-gray-600 text-sm">Students</span>
                        </div>
                        <span class="font-bold text-gray-800">@Model.StudentCount</span>
                    </div>
                    <div class="flex justify-between items-center">
                        <div class="flex items-center">
                            <span class="w-3 h-3 rounded-full bg-green-500 mr-2"></span>
                            <span class="text-gray-600 text-sm">Teachers</span>
                        </div>
                        <span class="font-bold text-gray-800">@Model.TeacherCount</span>
                    </div>
                    <div class="flex justify-between items-center">
                        <div class="flex items-center">
                            <span class="w-3 h-3 rounded-full bg-gray-300 mr-2"></span>
                            <span class="text-gray-600 text-sm">Admins</span>
                        </div>
                        <span class="font-bold text-gray-800">@Model.AdminCount</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="bg-white rounded-lg shadow p-6">
            <div class="flex justify-between items-start mb-4">
                <div>
                    <h3 class="text-lg font-semibold text-gray-700">Class Statistics</h3>
                    <p class="text-sm text-gray-500">Total Classes: <span class="font-bold text-gray-800">@Model.TotalClasses</span></p>
                </div>
            </div>

            <div class="flex items-center">
                <div class="w-1/2 h-48">
                    <canvas id="classChart"></canvas>
                </div>

                <div class="w-1/2 pl-6 space-y-3">
                    <div class="flex justify-between items-center">
                        <div class="flex items-center">
                            <span class="w-3 h-3 rounded-full bg-green-500 mr-2"></span>
                            <span class="text-gray-600 text-sm">Active</span>
                        </div>
                        <span class="font-bold text-gray-800">@Model.ActiveClasses</span>
                    </div>
                    <div class="flex justify-between items-center">
                        <div class="flex items-center">
                            <span class="w-3 h-3 rounded-full bg-red-500 mr-2"></span>
                            <span class="text-gray-600 text-sm">Inactive</span>
                        </div>
                        <span class="font-bold text-gray-800">@Model.InactiveClasses</span>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <script>
        // Define Colors
        const colors = {
            blue: '#3B82F6',
            green: '#10B981',
            gray: '#D1D5DB',
            red: '#EF4444'
        };

        // --- 1. User Donut Chart ---
        const userCtx = document.getElementById('userChart').getContext('2d');
        new Chart(userCtx, {
            type: 'doughnut',
            data: {
                labels: ['Students', 'Teachers', 'Admins'],
                datasets: [{
                    data: [@Model.StudentCount, @Model.TeacherCount, @Model.AdminCount],
                    backgroundColor: [colors.blue, colors.green, colors.gray],
                    borderWidth: 0,
                    hoverOffset: 4
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false } 
                },
                cutout: '70%' 
            }
        });

        //Class Donut Chart
        const classCtx = document.getElementById('classChart').getContext('2d');
        new Chart(classCtx, {
            type: 'doughnut',
            data: {
                labels: ['Active', 'Inactive'],
                datasets: [{
                    data: [@Model.ActiveClasses, @Model.InactiveClasses],
                    backgroundColor: [colors.green, colors.red],
                    borderWidth: 0,
                    hoverOffset: 4
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false } 
                },
                cutout: '70%'
            }
        });
    </script>
}