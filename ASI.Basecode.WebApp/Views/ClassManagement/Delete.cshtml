@model ASI.Basecode.Data.Models.Class

<div class="space-y-6">
    <p class="text-gray-700">
        Are you sure you want to delete class 
        <span class="font-semibold text-red-600">@Model.Id</span>?
        <br />
        This action is <strong>irreversible</strong>.
    </p>

    <div class="flex justify-end space-x-3 pt-4 border-t">
        <button type="button" class="px-4 py-2 bg-gray-200 text-gray-800 rounded hover:bg-gray-300"
                onclick="closeModal('modalDelete')">
            Cancel
        </button>
        <button type="button" class="px-4 py-2 bg-red-600 text-white rounded hover:bg-red-700"
                onclick="confirmDelete('@Model.Id')">
            Delete
        </button>
    </div>
</div>
