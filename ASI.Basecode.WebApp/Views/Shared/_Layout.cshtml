@using Microsoft.AspNetCore.Identity
@using ASI.Basecode.Data.Models
@inject UserManager<User> UserManager

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Student_Performance_Tracker</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Student_Performance_Tracker.styles.css" asp-append-version="true" />
    <style>
        /* Custom Active State for Sidebar */
        .sidebar-active {
            background-color: #3A4D75 !important; /* Navy Blue */
            color: white !important;               /* White Text */
            border-radius: 0.5rem;
        }

        /* Force white icon in active state */
        .sidebar-active i {
            color: white !important;
        }

        .submenu {
            max-height: 0;
            overflow: hidden;
            transition: max-height 0.3s ease-out;
        }

        .submenu.open {
            max-height: 200px;
        }

        .rotate-90 {
            transform: rotate(90deg);
        }

        .logout-btn {
            background-color: #3A4D75;
            color: white;
        }

        .logout-btn:hover {
            background-color: #2d3a5a;
        }
    </style>
</head>

<body class="bg-gray-50">
    <div class="flex h-screen">
        <!-- Sidebar -->
        <div class="w-64 bg-white shadow-md">
            <!-- Logo (Fixed Height h-16 to match header) -->
            <div class="h-16 flex items-center px-6 border-b">
                <h1 class="text-xl font-bold text-gray-800">ACADIFY</h1>
            </div>

            <!-- Navigation (space-y-2 for tighter gaps) -->
            <nav class="mt-8 px-2 space-y-2">
                
                <!-- Dashboard -->
                <div>
                    <a asp-controller="Home" asp-action="Dashboard"
                        class="flex items-center px-4 py-3 text-sm font-medium text-gray-700 hover:bg-gray-100 cursor-pointer sidebar-item transition-colors duration-200 rounded-lg">
                        <i class="fas fa-tachometer-alt mr-3 text-gray-500"></i>
                        Dashboard
                    </a>
                </div>

                <!-- My Grades -->
                <div>
                    <a asp-controller="GradeManagement" asp-action="GradeView"
                        class="flex items-center px-4 py-3 text-sm font-medium text-gray-700 hover:bg-gray-100 cursor-pointer sidebar-item transition-colors duration-200 rounded-lg">
                        <i class="fas fa-graduation-cap mr-3 text-gray-500"></i>
                        My Grades
                    </a>
                </div>

                <!-- Setting -->
                <div>
                    <a asp-controller="Settings" asp-action="Index"
                        class="flex items-center px-4 py-3 text-sm font-medium text-gray-700 hover:bg-gray-100 cursor-pointer sidebar-item transition-colors duration-200 rounded-lg">
                        <i class="fas fa-cog mr-3 text-gray-500"></i>
                        Settings
                    </a>
                </div>
            </nav>
        </div>

        <!-- Main Content Area -->
        <div class="flex-1 flex flex-col overflow-hidden">
            <!-- Header -->
            <header>
                <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3 h-16 px-6 flex items-center">
                    <div class="container-fluid p-0">
                        <!-- Changed justify-between to justify-end to align content to the right -->
                        <div class="flex items-center justify-end w-full">
                            
                            <!-- RIGHT SIDE: User Name and Logout Button -->
                            <div class="flex items-center space-x-4">
                                @{
                                    // Logic to fetch user's first and last name
                                    var currentUser = await UserManager.GetUserAsync(User);
                                    var displayName = currentUser != null 
                                        ? $"{currentUser.FirstName} {currentUser.LastName}" 
                                        : User.Identity?.Name;
                                }
                                <div class="hidden sm:flex items-center text-sm text-gray-700 border-r pr-4 border-gray-300">
                                    <i class="fas fa-user-circle mr-2 text-gray-400 text-lg"></i>
                                    <!-- DISPLAYING FIRST AND LAST NAME -->
                                    <span class="font-semibold text-gray-900">@displayName</span>
                                </div>

                                <!-- Logout Button -->
                                <form asp-controller="Settings" asp-action="Logout" method="post"
                                    class="hidden sm:block">
                                    @Html.AntiForgeryToken()
                                    <button type="submit"
                                        class="logout-btn flex items-center px-4 py-2 text-sm rounded-lg transition-colors duration-200">
                                        <i class="fas fa-sign-out-alt mr-2"></i>
                                        Log Out
                                    </button>
                                </form>
                            </div>
                        </div>

                        <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                            data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                            aria-expanded="false" aria-label="Toggle navigation">
                            <span class="navbar-toggler-icon"></span>
                        </button>

                        <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                            <ul class="navbar-nav flex-grow-1">
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-area="" asp-controller="Home"
                                        asp-action="Index">Home</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-area="" asp-controller="Home"
                                        asp-action="Privacy">Privacy</a>
                                </li>
                            </ul>

                            <!-- Mobile Logout Button -->
                            <div class="sm:hidden mt-2">
                                <form asp-controller="Settings" asp-action="Logout" method="post">
                                    @Html.AntiForgeryToken()
                                    <button type="submit"
                                        class="logout-btn w-full flex items-center justify-center px-4 py-2 text-sm rounded-lg transition-colors duration-200">
                                        <i class="fas fa-sign-out-alt mr-2"></i>
                                        Log Out
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </nav>
            </header>

            <!-- Main Content -->
            <div class="flex-1 overflow-y-auto">
                <div class="container">
                    <main role="main" class="pb-3">
                        @RenderBody()
                    </main>
                </div>
            </div>

            <!-- Footer -->
            <footer class="border-top footer text-muted">
                <div class="container">
                    &copy; 2025 - Student_Performance_Tracker - <a asp-area="" asp-controller="Home"
                        asp-action="Privacy">Privacy</a>
                </div>
            </footer>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Toggle year submenus
            const yearToggles = document.querySelectorAll('.year-toggle');
            yearToggles.forEach(toggle => {
                toggle.addEventListener('click', function () {
                    const submenu = this.nextElementSibling;
                    const chevron = this.querySelector('.chevron');
                    submenu.classList.toggle('open');
                    chevron.classList.toggle('rotate-90');
                });
            });

            // Sidebar Active State Logic
            const sidebarItems = document.querySelectorAll('.sidebar-item');
            const currentPath = window.location.pathname.toLowerCase();

            function setActiveState(element) {
                // 1. Reset all items to default state
                sidebarItems.forEach(i => {
                    i.classList.remove('sidebar-active');
                    i.classList.add('text-gray-700', 'hover:bg-gray-100');
                });

                // 2. Set active state for clicked/current element
                element.classList.add('sidebar-active');
                element.classList.remove('text-gray-700', 'hover:bg-gray-100');
            }

            sidebarItems.forEach(item => {
                // Click Listener
                item.addEventListener('click', function (e) {
                    setActiveState(this);
                });

                // Initial Load Listener
                const href = item.getAttribute('href') || '';
                if (href.length > 1 && currentPath.includes(href.toLowerCase().replace('~', ''))) {
                    setActiveState(item);
                }
            });
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>