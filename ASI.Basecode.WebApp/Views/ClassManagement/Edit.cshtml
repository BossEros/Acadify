@model ASI.Basecode.Data.Models.Class

@{
    Layout = null;
}

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />

    <div class="modal fade show d-block" id="editClassModal" tabindex="-1" role="dialog" aria-labelledby="editClassModalLabel" aria-modal="true">
        <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
            <div class="modal-content shadow-lg rounded-4 border-0">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold" id="editClassModalLabel">Edit Class</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body">
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label">EDP Code</label>
                            <input asp-for="Id" class="form-control" readonly />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Status</label>
                            <select asp-for="IsActive" class="form-select">
                                <option value="true">Active</option>
                                <option value="false">Inactive</option>
                            </select>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label">Course Code</label>
                            <select id="courseSelect" asp-for="CourseId" asp-items="ViewBag.Courses" class="form-select"></select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Course Name</label>
                            <input id="courseName" class="form-control" readonly />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Units</label>
                        <input id="courseUnit" class="form-control" readonly />
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label">Teacher</label>
                            <select id="teacherSelect" asp-for="TeacherId" asp-items="ViewBag.Teachers" class="form-select"></select>
                        </div>

                        <div class="col-md-3">
                            <label class="form-label">Semester</label>
                            <select asp-for="Semester" class="form-select">
                                <option>1</option>
                                <option>2</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Year</label>
                            <select asp-for="YearLevel" class="form-select">
                                <option>1</option>
                                <option>2</option>
                                <option>3</option>
                                <option>4</option>
                            </select>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label d-block">Days</label>
                            <div class="d-flex flex-wrap gap-3">
                                @foreach (var day in new[] { "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday" })
                                {
                                    <div class="form-check form-check-inline">
                                        <input type="checkbox" class="form-check-input" id="@day" name="Days" value="@day">
                                        <label class="form-check-label" for="@day">@day</label>
                                    </div>
                                }
                            </div>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Start Time</label>
                            <input type="time" class="form-control" id="startTime" name="StartTime" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">End Time</label>
                            <input type="time" class="form-control" id="endTime" name="EndTime" />
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label">Room</label>
                            <input asp-for="Room" class="form-control" />
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary">Update Class</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>

<style>
    body {
        background-color: rgba(0, 0, 0, 0.5);
    }
    .modal-backdrop {
        display: none;
    }
</style>

<script>
    // preloads data for lookup 
    const courses = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
        ViewBag.CourseList ?? new List<object>()
    ));

    const courseSelect = document.getElementById('courseSelect');
    const courseName = document.getElementById('courseName');
    const courseUnit = document.getElementById('courseUnit');

    function updateCourseDetails() {
        if (!courseSelect) return;
        const selected = courses.find(c => c.id == courseSelect.value);
        if (courseName) courseName.value = selected ? selected.courseName : '';
        if (courseUnit) courseUnit.value = selected ? selected.courseUnit : '';
    }

    if (courseSelect) {
        courseSelect.addEventListener('change', updateCourseDetails);
    }

    document.addEventListener('shown.bs.modal', function (event) {
        if (event.target.id === 'createClassModal' || event.target.id === 'editClassModal') {
            updateCourseDetails();
        }
    });

    updateCourseDetails();
</script>
