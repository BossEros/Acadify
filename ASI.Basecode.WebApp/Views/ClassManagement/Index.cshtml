@model IEnumerable<ASI.Basecode.Data.Models.Class>
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Class Management";
}

<div class="flex flex-col space-y-4">
    <!-- Status message -->
    <div id="successMessage" class="hidden p-4 rounded-lg bg-green-50 border border-green-200 shadow-sm">
        <div class="flex items-center">
            <svg class="w-5 h-5 text-green-500 mr-3" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
            </svg>
            <span id="successMessageText" class="text-green-800 font-medium"></span>
        </div>
    </div>

    @if (TempData["Message"] != null)
    {
        <div class="p-4 rounded-lg shadow-sm @(TempData["MessageType"]?.ToString() == "success" ? "bg-green-50 border border-green-200" : "bg-red-50 border border-red-200")">
            <div class="flex items-center">
                @if (TempData["MessageType"]?.ToString() == "success")
                {
                    <svg class="w-5 h-5 text-green-500 mr-3" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                    </svg>
                    <span class="text-green-800 font-medium">@TempData["Message"]</span>
                }
                else
                {
                    <svg class="w-5 h-5 text-red-500 mr-3" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/>
                    </svg>
                    <span class="text-red-800 font-medium">@TempData["Message"]</span>
                }
            </div>
        </div>
    }

    <!-- Header -->
    <div class="flex items-start justify-between">
        <div>
            <h1 class="text-2xl font-semibold">Class Management</h1>
            <p class="text-gray-500">Manage all your classes</p>
        </div>
    </div>

    <div class="flex items-center gap-3 w-full">
        <button type="button" id="openCreate"
                class="bg-green-600 hover:bg-green-700 text-white px-4 py-2 rounded">
            Create Class
        </button>

        <div class="w-72 ml-auto">
            <label class="sr-only" for="searchEdpCode">Search by EDP Code</label>
            <div class="relative">
            <input id="searchEdpCode" type="text" placeholder="Search by EDP Code"
                    class="w-full rounded border border-gray-300 pl-3 pr-10 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500" />
            <button type="button" id="btnSearchGlobal"
                    class="absolute right-1 top-1/2 -translate-y-1/2 text-gray-600 hover:text-gray-800 p-1"
                    aria-label="Search">
            </button>
            </div>
        </div>
    </div>


    <!-- Table -->
    <div class="bg-white rounded-lg shadow p-4">
        <table class="w-full border-collapse">
            <thead class="bg-gray-50">
                <tr>
                    <th class="p-3 text-left text-xs font-semibold text-gray-600">EDP CODE</th>
                    <th class="p-3 text-left text-xs font-semibold text-gray-600">COURSE CODE</th>
                    <th class="p-3 text-left text-xs font-semibold text-gray-600">DESCRIPTION</th>
                    <th class="p-3 text-left text-xs font-semibold text-gray-600">UNITS</th>
                    <th class="p-3 text-left text-xs font-semibold text-gray-600">SCHEDULE</th>
                    <th class="p-3 text-left text-xs font-semibold text-gray-600">TEACHER</th>
                    <th class="p-3 text-left text-xs font-semibold text-gray-600">YEAR</th>
                    <th class="p-3 text-left text-xs font-semibold text-gray-600">SEMESTER</th>
                    <th class="p-3 text-left text-xs font-semibold text-gray-600">STATUS</th>
                    <th class="p-3 text-right text-xs font-semibold text-gray-600">ACTIONS</th>
                </tr>
            </thead>
            <tbody id="classTbody">
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr class="border-b" data-edp="@item.Id">
                            <td class="p-3">@item.Id</td>
                            <td class="p-3">@item.Course?.CourseCode</td>
                            <td class="p-3">@item.Course?.CourseName</td>
                            <td class="p-3">@item.Course?.Units</td>
                            <td class="p-3">@item.Schedule</td>
                            <td class="p-3">@($"{item.Teacher?.FirstName} {item.Teacher?.LastName}")</td>
                            <td class="p-3">@item.Course?.YearLevel</td>
                            <td class="p-3">@item.Semester</td>
                            <td class="p-3">
                                @if (item.IsActive)
                                {
                                    <span class="inline-block rounded-full bg-green-100 text-green-700 text-xs px-2 py-1">Active</span>
                                }
                                else
                                {
                                    <span class="inline-block rounded-full bg-red-100 text-red-700 text-xs px-2 py-1">Inactive</span>
                                }
                            </td>
                            <td class="p-3 relative text-right">
                                <button type="button" class="action-btn p-2 rounded hover:bg-gray-100 focus:outline-none">
                                    ⋮
                                </button>
                                <div class="action-menu hidden absolute right-0 mt-2 w-32 bg-white border border-gray-200 rounded-lg shadow-lg z-10">
                                    <button type="button" class="w-full text-left px-4 py-2 text-sm hover:bg-gray-100 edit-btn" data-id="@item.Id">
                                        ✏️ Edit
                                    </button>
                                    <button type="button" class="w-full text-left px-4 py-2 text-sm hover:bg-gray-100 delete-btn" data-id="@item.Id">
                                        🗑️ Delete
                                    </button>
                                    <button type="button" class="w-full text-left px-4 py-2 text-sm hover:bg-gray-100 details-btn" data-id="@item.Id">
                                        📄 Details
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="10" class="text-center text-gray-500 py-3">No classes found.</td></tr>
                }
            </tbody>
        </table>
    </div>

    @Html.AntiForgeryToken()

    <!-- Modals -->
    <div id="modalDetails" class="hidden fixed inset-0 z-50 items-center justify-center bg-gray-900/50 backdrop-blur">
        <div class="bg-white w-full max-w-2xl rounded-xl shadow p-6">
            <h3 class="text-xl font-semibold mb-4">Class Details</h3>
            <div id="detailsContent"></div>
        </div>
    </div>

    <div id="modalCreate" class="hidden fixed inset-0 z-50 items-center justify-center bg-gray-900/50 backdrop-blur">
        <div class="bg-white w-full max-w-2xl rounded-xl shadow p-6">
            <h3 class="text-xl font-semibold mb-4">Create Class</h3>
            <div id="createContent"></div>
        </div>
    </div>

    <div id="modalEdit" class="hidden fixed inset-0 z-50 items-center justify-center bg-gray-900/50 backdrop-blur">
        <div class="bg-white w-full max-w-2xl rounded-xl shadow p-6">
            <h3 class="text-xl font-semibold mb-4">Edit Class</h3>
            <div id="editContent"></div>
        </div>
    </div>

    <div id="modalDelete" class="hidden fixed inset-0 z-50 items-center justify-center bg-gray-900/50 backdrop-blur">
        <div class="bg-white w-full max-w-md rounded-xl shadow p-6">
            <h3 class="text-xl font-semibold mb-4">Delete Class</h3>
            <div id="deleteContent"></div>
        </div>
    </div>
</div>

<!-- Scripts -->
<script>
(function () {
    const qs = (s) => document.querySelector(s);
    const qsa = (s) => document.querySelectorAll(s);

    // Check for success message from sessionStorage
    const successMsg = sessionStorage.getItem('successMessage');
    if (successMsg) {
        const msgDiv = qs('#successMessage');
        const msgText = qs('#successMessageText');
        msgText.textContent = successMsg;
        msgDiv.classList.remove('hidden');
        sessionStorage.removeItem('successMessage');

        // Auto-hide after 5 seconds
        setTimeout(() => {
            msgDiv.classList.add('hidden');
        }, 5000);
    }

    function openModal(id, url, target) {
        const modal = qs('#' + id);
        modal.classList.remove('hidden');
        modal.classList.add('flex');
        qs(target).innerHTML = '<div class="py-8 text-center text-gray-500">Loading...</div>';
        fetch(url).then(r => r.text()).then(html => qs(target).innerHTML = html);
    }

    function closeModal(id) {
        const modal = qs('#' + id);
        modal.classList.add('hidden');
        modal.classList.remove('flex');
    }

    // Expose closeModal globally (for partials)
    window.closeModal = closeModal;

    // Handle form submission for Create and Edit modals
    document.addEventListener('submit', function(e) {
        if (e.target.id === 'createClassForm' || e.target.id === 'editClassForm') {
            e.preventDefault();

            const form = e.target;
            const formData = new FormData(form);
            const isEdit = e.target.id === 'editClassForm';
            const validationSummary = qs(isEdit ? '#validationSummaryEdit' : '#validationSummary');
            const validationErrors = qs(isEdit ? '#validationErrorsEdit' : '#validationErrors');

            // Hide previous errors
            if (validationSummary) {
                validationSummary.classList.add('hidden');
                validationErrors.innerHTML = '';
            }

            fetch(form.action, {
                method: 'POST',
                body: formData,
                headers: {
                    'X-Requested-With': 'XMLHttpRequest'
                }
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    // Store success message and reload
                    sessionStorage.setItem('successMessage', data.message);
                    window.location.href = '@Url.Action("Index", "ClassManagement")';
                } else {
                    // Show validation errors
                    if (validationSummary) {
                        validationSummary.classList.remove('hidden');
                        if (data.errors && data.errors.length > 0) {
                            data.errors.forEach(error => {
                                const li = document.createElement('li');
                                li.textContent = error;
                                validationErrors.appendChild(li);
                            });
                        }
                    }
                }
            })
            .catch(error => {
                console.error('Error:', error);
            });
        }
    });

    // Create
    qs('#openCreate').addEventListener('click', () =>
        openModal('modalCreate', '@Url.Action("Create","ClassManagement")', '#createContent')
    );

    // Outside click close
    qsa('[id^="modal"]').forEach(m => {
        m.addEventListener('click', e => { if (e.target === m) closeModal(m.id); });
    });

    // Action menu toggle
    document.addEventListener('click', e => {
        const isActionBtn = e.target.closest('.action-btn');
        const isInsideMenu = e.target.closest('.action-menu');
        qsa('.action-menu').forEach(m => m.classList.add('hidden'));
        if (isActionBtn) {
            const menu = isActionBtn.parentElement.querySelector('.action-menu');
            menu.classList.toggle('hidden');
        }
        if (isInsideMenu) e.stopPropagation();
    });

    // Edit
    document.addEventListener('click', e => {
        const btn = e.target.closest('.edit-btn');
        if (btn) {
            const id = btn.dataset.id;
            openModal('modalEdit', `@Url.Action("Edit","ClassManagement")/${id}`, '#editContent');
        }
    });

    // Delete
    document.addEventListener('click', e => {
        const btn = e.target.closest('.delete-btn');
        if (btn) {
            const id = btn.dataset.id;
            openModal('modalDelete', `@Url.Action("Delete","ClassManagement")/${id}`, '#deleteContent');
        }
    });

    // Details
    document.addEventListener('click', e => {
        const btn = e.target.closest('.details-btn');
        if (btn) {
            const id = btn.dataset.id;
            openModal('modalDetails', `@Url.Action("Details","ClassManagement")/${id}`, '#detailsContent');
        }
    });

    // Confirm delete (called from partial)
    window.confirmDelete = function (id) {
        fetch(`@Url.Action("ConfirmDelete","ClassManagement")/${id}`, {
            method: 'POST',
            headers: {
                'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
            }
        })
        .then(r => r.json())
        .then(data => {
            if (data.success) {
                alert(data.message);
                const row = document.querySelector(`[data-edp="${id}"]`);
                if (row) row.remove();
                closeModal('modalDelete');
            } else {
                alert(data.message);
            }
        })
        .catch(() => {
            alert("An error occurred while deleting the class.");
        });
    };

    // Search
    const tbody = qs('#classTbody');
    const originalRows = Array.from(tbody.children);
    function resetTable() {
        tbody.innerHTML = '';
        originalRows.forEach(r => { r.classList.remove('ring-2','ring-blue-300'); tbody.appendChild(r); });
    }
    function reorderForSearch(term) {
        if (!term) { resetTable(); return; }
        const rows = Array.from(tbody.children);
        let match = rows.find(r => r.dataset.edp?.toLowerCase() === term.toLowerCase())
                 || rows.find(r => r.dataset.edp?.toLowerCase().startsWith(term.toLowerCase()));
        if (!match) return;
        tbody.prepend(match);
        match.classList.add('ring-2', 'ring-blue-300');
        setTimeout(() => match.classList.remove('ring-2', 'ring-blue-300'), 1200);
    }
    qs('#searchEdpCode').addEventListener('input', (e) => {
        const value = e.target.value.trim();
        resetTable();
        reorderForSearch(value);
    });
})();
</script>

<style>
    .action-btn {
        font-size: 1.25rem;
        line-height: 1;
    }
    .action-menu button {
        transition: background 0.15s;
    }
</style>
