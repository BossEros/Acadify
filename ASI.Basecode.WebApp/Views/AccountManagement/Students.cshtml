@model ASI.Basecode.WebApp.ViewModels.AccountManagement.UserListViewModel
@{
    ViewData["Title"] = "Student Management";
    Layout = "_AdminLayout";
}

<div class="container mx-auto px-4 py-8">
    <div class="mb-6">
        <h1 class="text-2xl font-bold text-gray-800">Student Management</h1>
        <p class="text-gray-600">Manage student accounts and class enrollments</p>
    </div>

    <!-- Search Section -->
    <div class="bg-white rounded-lg shadow p-6 mb-6">
        <h2 class="text-lg font-semibold mb-4">Find Student</h2>
        <div class="flex gap-4">
            <input type="text" id="searchInput" placeholder="Enter ID Number or Email"
                   class="flex-1 px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
            <button onclick="findUser()" class="bg-blue-600 hover:bg-blue-700 text-white px-6 py-2 rounded-lg flex items-center">
                <i class="fas fa-search mr-2"></i> Find User
            </button>
            <button onclick="deleteUser()" class="bg-red-600 hover:bg-red-700 text-white px-6 py-2 rounded-lg flex items-center">
                <i class="fas fa-trash mr-2"></i> Delete User
            </button>
        </div>
    </div>

    <!-- Student Actions Section -->
    <div id="studentActions" class="bg-white rounded-lg shadow p-6 mb-6 hidden">
        <h2 class="text-lg font-semibold mb-4">Student Actions</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
            <button onclick="showEnrollModal()" class="bg-green-600 hover:bg-green-700 text-white px-4 py-3 rounded-lg flex items-center justify-center">
                <i class="fas fa-user-plus mr-2"></i> Enroll Student
            </button>
            <button onclick="showUnenrollModal()" class="bg-yellow-600 hover:bg-yellow-700 text-white px-4 py-3 rounded-lg flex items-center justify-center">
                <i class="fas fa-user-minus mr-2"></i> Unenroll Student
            </button>
            <button onclick="showEditModal()" class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-3 rounded-lg flex items-center justify-center">
                <i class="fas fa-edit mr-2"></i> Edit
            </button>
        </div>

        <!-- Student Info -->
        <div id="studentInfo" class="border-t pt-4"></div>

        <!-- Enrolled Classes -->
        <div id="enrolledClasses" class="border-t pt-4 mt-4 hidden">
            <h3 class="text-md font-semibold mb-2">Enrolled Classes</h3>
            <div id="classesList" class="space-y-2"></div>
        </div>
    </div>

    <!-- Students List -->
    <div class="bg-white rounded-lg shadow">
        <div class="px-6 py-4 border-b">
            <h2 class="text-lg font-semibold">All Students</h2>
        </div>
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200">
                <thead class="bg-gray-50">
                    <tr>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">ID Number</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Name</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Email</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
                    </tr>
                </thead>
                <tbody class="bg-white divide-y divide-gray-200">
                    @foreach (var student in Model.Users)
                    {
                        <tr>
                            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">@student.IdNumber</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">@student.FullName</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">@student.Email</td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full @(student.IsActive ? "bg-green-100 text-green-800" : "bg-red-100 text-red-800")">
                                    @(student.IsActive ? "Active" : "Inactive")
                                </span>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
                                <button onclick="loadStudent('@student.IdNumber')" class="text-blue-600 hover:text-blue-900 mr-3">Select</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modals -->
<div id="enrollModal" class="fixed inset-0 bg-gray-600 bg-opacity-50 overflow-y-auto h-full w-full hidden">
    <div class="relative top-20 mx-auto p-5 border w-96 shadow-lg rounded-md bg-white">
        <div class="mt-3">
            <h3 class="text-lg font-medium text-gray-900">Enroll Student</h3>
            <div class="mt-2">
                <input type="text" id="enrollEdpCode" placeholder="Enter EDP Code" class="w-full px-3 py-2 border border-gray-300 rounded-md">
            </div>
            <div class="flex justify-end space-x-3 mt-4">
                <button onclick="hideEnrollModal()" class="px-4 py-2 bg-gray-300 text-gray-700 rounded-md">Cancel</button>
                <button onclick="enrollStudent()" class="px-4 py-2 bg-green-600 text-white rounded-md">Enroll</button>
            </div>
        </div>
    </div>
</div>

<div id="unenrollModal" class="fixed inset-0 bg-gray-600 bg-opacity-50 overflow-y-auto h-full w-full hidden">
    <div class="relative top-20 mx-auto p-5 border w-96 shadow-lg rounded-md bg-white">
        <div class="mt-3">
            <h3 class="text-lg font-medium text-gray-900">Unenroll Student</h3>
            <div class="mt-2">
                <input type="text" id="unenrollEdpCode" placeholder="Enter EDP Code" class="w-full px-3 py-2 border border-gray-300 rounded-md">
            </div>
            <div class="flex justify-end space-x-3 mt-4">
                <button onclick="hideUnenrollModal()" class="px-4 py-2 bg-gray-300 text-gray-700 rounded-md">Cancel</button>
                <button onclick="unenrollStudent()" class="px-4 py-2 bg-yellow-600 text-white rounded-md">Unenroll</button>
            </div>
        </div>
    </div>
</div>

<div id="editModal" class="fixed inset-0 bg-gray-600 bg-opacity-50 overflow-y-auto h-full w-full hidden">
    <div class="relative top-20 mx-auto p-5 border w-96 shadow-lg rounded-md bg-white">
        <div class="mt-3">
            <h3 class="text-lg font-medium text-gray-900">Edit Student</h3>
            <div class="mt-2 space-y-3">
                <div>
                    <label class="block text-sm font-medium text-gray-700">Email</label>
                    <input type="email" id="editEmail" class="w-full px-3 py-2 border border-gray-300 rounded-md">
                </div>
                <div class="flex items-center">
                    <input type="checkbox" id="editIsActive" class="h-4 w-4 text-blue-600 border-gray-300 rounded">
                    <label class="ml-2 block text-sm text-gray-900">Active</label>
                </div>
            </div>
            <div class="flex justify-end space-x-3 mt-4">
                <button onclick="hideEditModal()" class="px-4 py-2 bg-gray-300 text-gray-700 rounded-md">Cancel</button>
                <button onclick="updateStudent()" class="px-4 py-2 bg-blue-600 text-white rounded-md">Update</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let currentUserId = 0;

        function findUser() {
            const searchTerm = document.getElementById('searchInput').value.trim();
            if (!searchTerm) {
                alert('Please enter an ID Number or Email');
                return;
            }

            fetch('@Url.Action("FindUser", "AccountManagement")?searchTerm=' + encodeURIComponent(searchTerm))
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        currentUserId = data.data.id; // primary key used for server operations
                        displayUserInfo(data.data);
                        loadEnrolledClasses();
                        showStudentActions();
                    } else {
                        alert(data.message);
                        hideStudentActions();
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    alert('Error searching for user');
                });
        }

        function loadStudent(idNumber) {
            fetch('@Url.Action("FindUser", "AccountManagement")?searchTerm=' + idNumber)
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        currentUserId = data.data.id;
                        displayUserInfo(data.data);
                        loadEnrolledClasses();
                        showStudentActions();
                        document.getElementById('searchInput').value = idNumber;
                    } else {
                        alert(data.message);
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    alert('Error loading student');
                });
        }

        function displayUserInfo(user) {
            const studentInfo = document.getElementById('studentInfo');
            studentInfo.innerHTML = `
                <h3 class="text-md font-semibold mb-2">Student Information</h3>
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="text-sm text-gray-600">ID Number:</label>
                        <p class="font-medium">${user.idNumber}</p>
                    </div>
                    <div>
                        <label class="text-sm text-gray-600">Name:</label>
                        <p class="font-medium">${user.firstName} ${user.lastName}</p>
                    </div>
                    <div>
                        <label class="text-sm text-gray-600">Email:</label>
                        <p class="font-medium">${user.email}</p>
                    </div>
                    <div>
                        <label class="text-sm text-gray-600">Status:</label>
                        <p class="font-medium"><span class="px-2 py-1 rounded-full text-xs ${user.isActive ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800'}">${user.isActive ? 'Active' : 'Inactive'}</span></p>
                    </div>
                </div>
            `;
        }

        function loadEnrolledClasses() {
            fetch('@Url.Action("GetEnrolledClasses", "AccountManagement")?userId=' + currentUserId)
                .then(response => response.json())
                .then(data => {
                    const classesList = document.getElementById('classesList');
                    const enrolledClasses = document.getElementById('enrolledClasses');

                    if (data.success && data.data && data.data.length > 0) {
                        classesList.innerHTML = data.data.map(cls => `
                            <div class="flex justify-between items-center p-2 bg-gray-50 rounded">
                                <span class="font-medium">${cls.edpCode}</span>
                                <span class="text-sm text-gray-600">${cls.className}</span>
                            </div>
                        `).join('');
                        enrolledClasses.classList.remove('hidden');
                    } else {
                        classesList.innerHTML = '<p class="text-gray-500">No enrolled classes</p>';
                        enrolledClasses.classList.remove('hidden');
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                });
        }

        function showStudentActions() {
            document.getElementById('studentActions').classList.remove('hidden');
        }

        function hideStudentActions() {
            document.getElementById('studentActions').classList.add('hidden');
        }

        // Modal Functions
        function showEnrollModal() {
            document.getElementById('enrollModal').classList.remove('hidden');
        }

        function hideEnrollModal() {
            document.getElementById('enrollModal').classList.add('hidden');
        }

        function showUnenrollModal() {
            document.getElementById('unenrollModal').classList.remove('hidden');
        }

        function hideUnenrollModal() {
            document.getElementById('unenrollModal').classList.add('hidden');
        }

        function showEditModal() {
            // Pre-fill current values
            fetch('@Url.Action("FindUser", "AccountManagement")?searchTerm=' + currentUserId)
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        document.getElementById('editEmail').value = data.data.email;
                        document.getElementById('editIsActive').checked = data.data.isActive;
                        document.getElementById('editModal').classList.remove('hidden');
                    }
                });
        }

        function hideEditModal() {
            document.getElementById('editModal').classList.add('hidden');
        }

        // Action Functions
        function enrollStudent() {
            const edpCode = document.getElementById('enrollEdpCode').value.trim();
            if (!edpCode) {
                alert('Please enter EDP Code');
                return;
            }

            fetch('@Url.Action("EnrollStudent", "AccountManagement")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                },
                body: JSON.stringify({ userId: currentUserId, edpCode: edpCode })
            })
            .then(response => response.json())
            .then(data => {
                alert(data.message);
                if (data.success) {
                    hideEnrollModal();
                    loadEnrolledClasses();
                    document.getElementById('enrollEdpCode').value = '';
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert('Error enrolling student');
            });
        }

        function unenrollStudent() {
            const edpCode = document.getElementById('unenrollEdpCode').value.trim();
            if (!edpCode) {
                alert('Please enter EDP Code');
                return;
            }

            fetch('@Url.Action("UnenrollStudent", "AccountManagement")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                },
                body: JSON.stringify({ userId: currentUserId, edpCode: edpCode })
            })
            .then(response => response.json())
            .then(data => {
                alert(data.message);
                if (data.success) {
                    hideUnenrollModal();
                    loadEnrolledClasses();
                    document.getElementById('unenrollEdpCode').value = '';
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert('Error unenrolling student');
            });
        }

        function updateStudent() {
            const email = document.getElementById('editEmail').value.trim();
            const isActive = document.getElementById('editIsActive').checked;

            if (!email) {
                alert('Please enter email address');
                return;
            }

            fetch('@Url.Action("EditUser", "AccountManagement")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                },
                body: JSON.stringify({ userId: currentUserId, email: email, isActive: isActive })
            })
            .then(response => response.json())
            .then(data => {
                alert(data.message);
                if (data.success) {
                    hideEditModal();
                    loadStudent(currentUserId); // Reload user info
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert('Error updating student');
            });
        }

        function deleteUser() {
            if (!currentUserId) {
                alert('Please search for a user first');
                return;
            }

            if (!confirm('Are you sure you want to delete this user? This action cannot be undone.')) {
                return;
            }

            fetch('@Url.Action("DeleteUser", "AccountManagement")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                },
                body: JSON.stringify({ userId: currentUserId })
            })
            .then(response => response.json())
            .then(data => {
                alert(data.message);
                if (data.success) {
                    location.reload();
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert('Error deleting user');
            });
        }
    </script>
}