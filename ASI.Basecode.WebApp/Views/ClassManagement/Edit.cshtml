@model ASI.Basecode.WebApp.ViewModels.ClassManagement.EditClassViewModel
@{
    Layout = null;
}

<!-- Validation Summary -->
<div id="validationSummaryEdit" class="hidden mb-4 p-4 rounded bg-red-100 text-red-700">
    <ul id="validationErrorsEdit" class="list-disc list-inside space-y-1"></ul>
</div>

<form asp-action="Edit" method="post" id="editClassForm" class="space-y-4">
    @Html.AntiForgeryToken()

    <!-- EDP Code -->
    <div>
        <label class="block text-sm text-gray-700 mb-1">EDP Code</label>
        <input asp-for="Id" readonly
               class="w-full rounded border border-gray-300 bg-gray-100 px-3 py-2 focus:ring-2 focus:ring-green-500 focus:outline-none" />
    </div>

    <!-- Course Code & Description -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
            <label class="block text-sm text-gray-700 mb-1">Course Code</label>
            <select id="courseSelectEdit" asp-for="CourseId" asp-items="ViewBag.Courses"
                    class="w-full rounded border border-gray-300 bg-gray-100 px-3 py-2 text-gray-500 cursor-not-allowed"
                    disabled>
            </select>
        </div>
        <div>
            <label class="block text-sm text-gray-700 mb-1">Description</label>
            <input id="courseNameEdit" readonly
                   class="w-full rounded border border-gray-200 bg-gray-100 px-3 py-2" />
        </div>
    </div>

    <!-- Units -->
    <div>
        <label class="block text-sm text-gray-700 mb-1">Units</label>
        <input id="courseUnitEdit" readonly
               class="w-full rounded border border-gray-200 bg-gray-100 px-3 py-2" />
    </div>

    <!-- Schedule (Editable) -->
    <div>
        <label class="block text-sm text-gray-700 mb-1 font-semibold">Schedule</label>
        <div class="flex flex-wrap gap-4">
            @foreach (var day in new[] { "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday" })
            {
                var isChecked = Model.Days != null && Model.Days.Contains(day);
                <label class="inline-flex items-center space-x-1 text-sm">
                    <input type="checkbox" class="rounded border-gray-300 text-green-600 focus:ring-green-500"
                           id="@day" name="Days" value="@day" @(isChecked ? "checked" : "") />
                    <span>@day</span>
                </label>
            }
        </div>

        <div class="flex items-center space-x-2 mt-2">
            <input type="time" id="startTimeEdit" asp-for="StartTime"
                   class="w-full rounded border border-gray-300 px-3 py-2 focus:ring-2 focus:ring-green-500 focus:outline-none" />
            <span class="text-gray-500">-</span>
            <input type="time" id="endTimeEdit" asp-for="EndTime"
                   class="w-full rounded border border-gray-300 px-3 py-2 focus:ring-2 focus:ring-green-500 focus:outline-none" />
        </div>
    </div>

    <!-- Teacher (Editable) -->
    <div>
        <label class="block text-sm text-gray-700 mb-1 font-semibold">Teacher</label>
        <select id="teacherSelectEdit" asp-for="TeacherId" asp-items="ViewBag.Teachers"
                class="w-full rounded border border-gray-300 px-3 py-2 focus:ring-2 focus:ring-green-500 focus:outline-none">
            <option disabled value="">Select a teacher</option>
        </select>
    </div>

    <!-- Year & Semester (Read-only) -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
            <label class="block text-sm text-gray-700 mb-1">Year</label>
            <input value="@Model.YearLevel" readonly
                   class="w-full rounded border border-gray-200 bg-gray-100 px-3 py-2" />
        </div>
        <div>
            <label class="block text-sm text-gray-700 mb-1">Semester</label>
            <input value="@Model.Semester" readonly
                   class="w-full rounded border border-gray-200 bg-gray-100 px-3 py-2" />
        </div>
    </div>

    <!-- Buttons -->
    <div class="flex justify-end space-x-2 pt-2">
        <button type="button" class="px-4 py-2 bg-gray-200 text-gray-800 rounded hover:bg-gray-300" onclick="closeModal('modalEdit')">
            Cancel
        </button>
        <button type="submit" class="px-4 py-2 rounded bg-green-600 text-white hover:bg-green-700">
            Update
        </button>
    </div>
</form>

<script>
    const coursesEdit = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.CourseList ?? new List<object>()));
    const courseNameEdit = document.getElementById('courseNameEdit');   // Description readonly
    const courseUnitEdit = document.getElementById('courseUnitEdit');

    function updateCourseDetailsEdit() {
        const selected = coursesEdit.find(c => c.id == @Model.CourseId);
        courseNameEdit.value = selected ? (selected.courseDescription ?? selected.courseName) : '';
        courseUnitEdit.value = selected ? selected.courseUnit : '';
    }

    updateCourseDetailsEdit();
</script>

