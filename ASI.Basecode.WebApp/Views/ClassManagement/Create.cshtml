@model ASI.Basecode.WebApp.ViewModels.ClassManagement.CreateClassViewModel
@{
    Layout = null;
}

<!-- Validation Summary -->
<div id="validationSummary" class="hidden mb-4 p-4 rounded bg-red-100 text-red-700">
    <ul id="validationErrors" class="list-disc list-inside space-y-1"></ul>
</div>

<form asp-action="Create" method="post" id="createClassForm" class="space-y-4">
    @Html.AntiForgeryToken()

    <!-- Course Code & Description -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
            <label class="block text-sm text-gray-700 mb-1">Course Code</label>
            <select id="courseSelect" asp-for="CourseId" asp-items="ViewBag.Courses"
                    class="w-full rounded border border-gray-300 px-3 py-2 focus:ring-2 focus:ring-green-500 focus:outline-none">
                <option disabled selected value="">Select a course</option>
            </select>
        </div>
        <div>
            <label class="block text-sm text-gray-700 mb-1">Description</label>
            <input id="courseName" readonly placeholder="e.g., College Algebra"
                   class="w-full rounded border border-gray-200 bg-gray-100 px-3 py-2" />
        </div>
    </div>

    <!-- Units -->
    <div>
        <label class="block text-sm text-gray-700 mb-1">Units</label>
        <input id="courseUnit" readonly placeholder="e.g., 3"
               class="w-full rounded border border-gray-200 bg-gray-100 px-3 py-2" />
    </div>

    <!-- Days -->
    <div>
        <label class="block text-sm text-gray-700 mb-1">Days</label>
        <div class="flex flex-wrap gap-4">
            @foreach (var day in new[] { "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday" })
            {
                <label class="inline-flex items-center space-x-1 text-sm">
                    <input type="checkbox" class="rounded border-gray-300 text-green-600 focus:ring-green-500"
                           id="@day" name="Days" value="@day" />
                    <span>@day</span>
                </label>
            }
        </div>
    </div>

    <!-- Time -->
    <div>
        <label class="block text-sm text-gray-700 mb-1">Time</label>
        <div class="flex items-center space-x-2">
            <input type="time" id="startTime" asp-for="StartTime"
                   class="w-full rounded border border-gray-300 px-3 py-2 focus:ring-2 focus:ring-green-500 focus:outline-none" />
            <span class="text-gray-500">-</span>
            <input type="time" id="endTime" asp-for="EndTime"
                   class="w-full rounded border border-gray-300 px-3 py-2 focus:ring-2 focus:ring-green-500 focus:outline-none" />
        </div>
    </div>

    <!-- Teacher -->
    <div>
        <label class="block text-sm text-gray-700 mb-1">Teacher</label>
        <select id="teacherSelect" asp-for="TeacherId" asp-items="ViewBag.Teachers"
                class="w-full rounded border border-gray-300 px-3 py-2 focus:ring-2 focus:ring-green-500 focus:outline-none">
            <option disabled selected value="">Select a teacher</option>
        </select>
    </div>

    <!-- Year & Semester -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
            <label class="block text-sm text-gray-700 mb-1">Year</label>
            <select asp-for="YearLevel"
                    class="w-full rounded border border-gray-300 px-3 py-2 focus:ring-2 focus:ring-green-500 focus:outline-none">
                <option value="1">1st Year</option>
                <option value="2">2nd Year</option>
                <option value="3">3rd Year</option>
                <option value="4">4th Year</option>
            </select>
        </div>
        <div>
            <label class="block text-sm text-gray-700 mb-1">Semester</label>
            <select asp-for="Semester"
                    class="w-full rounded border border-gray-300 px-3 py-2 focus:ring-2 focus:ring-green-500 focus:outline-none">
                <option value="1">1st Semester</option>
                <option value="2">2nd Semester</option>
            </select>
        </div>
    </div>

    <!-- Buttons -->
    <div class="flex justify-end space-x-2 pt-2">
        <button type="button" class="px-4 py-2 bg-gray-200 text-gray-800 rounded hover:bg-gray-300" onclick="closeModal('modalCreate')">
            Cancel
        </button>
        <button type="submit" class="px-4 py-2 rounded bg-green-600 text-white hover:bg-green-700">
            Create
        </button>
    </div>
</form>

<script>
    const courses = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.CourseList ?? new List<object>()));
    const courseSelect = document.getElementById('courseSelect');
    const courseName = document.getElementById('courseName');     // this is your Description input
    const courseUnit = document.getElementById('courseUnit');

    function updateCourseDetails() {
        const selectedCourse = courses.find(c => c.id == courseSelect.value);
        courseName.value = selectedCourse ? (selectedCourse.courseDescription ?? selectedCourse.courseName) : '';
        courseUnit.value = selectedCourse ? selectedCourse.courseUnit : '';
    }

    courseSelect?.addEventListener('change', updateCourseDetails);
    updateCourseDetails();
</script>
