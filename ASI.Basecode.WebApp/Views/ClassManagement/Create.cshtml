@model ASI.Basecode.Data.Models.Class

@{
    Layout = null; /* if you want this to be loaded inside a modal dynamically */
}

<div class="modal fade show d-block" id="createClassModal" tabindex="-1" role="dialog" aria-labelledby="createClassModalLabel" aria-modal="true">
    <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
        <div class="modal-content shadow-lg rounded-4 border-0">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold" id="createClassModalLabel">Create New Class</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body">
                <form asp-action="Create" method="post" id="createClassForm">

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label">EDP Code</label>
                            <input id="Id" class="form-control" value="@ViewBag.NextEdpCode" readonly />
                        </div>
                    </div>

                     <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label">Course Code</label>
                            <select id="courseSelect" asp-for="CourseId" asp-items="ViewBag.Courses" class="form-select"></select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Description</label>
                            <input id="courseName" class="form-control" readonly />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Units</label>
                        <input id="courseUnit" class="form-control" readonly />
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label d-block">Days</label>
                            <div class="d-flex flex-wrap gap-3">
                                @foreach (var day in new[] { "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday" })
                                {
                                    <div class="form-check form-check-inline">
                                        <input type="checkbox" class="form-check-input" id="@day" name="Days" value="@day">
                                        <label class="form-check-label" for="@day">@day</label>
                                    </div>
                                }
                            </div>
                        </div>

                        <div class="col-md-3">
                            <label class="form-label">Start Time</label>
                            <input type="time" class="form-control" id="startTime" name="StartTime" />
                        </div>

                        <div class="col-md-3">
                            <label class="form-label">End Time</label>
                            <input type="time" class="form-control" id="endTime" name="EndTime" />
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label">Teacher</label>
                            <select id="teacherSelect" asp-for="TeacherId" asp-items="ViewBag.Teachers" class="form-select"></select>
                        </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label">Year</label>
                            <select asp-for="YearLevel" class="form-select">
                                <option>1</option>
                                <option>2</option>
                                <option>3</option>
                                <option>4</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Semester</label>
                            <select asp-for="Semester" class="form-select">
                                <option>1</option>
                                <option>2</option>
                            </select>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-success px-4">Create</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<style>
    body {
        background-color: rgba(0, 0, 0, 0.5);
    }
    .modal-backdrop {
        display: none;
    }
</style>

<script>
    // preload data for lookup
    // courses
    const courses = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
        ViewBag.CourseList ?? new List<object>()
    ));

    const courseSelect = document.getElementById('courseSelect');
    const courseName = document.getElementById('courseName');
    const courseUnit = document.getElementById('courseUnit');

    courseSelect.addEventListener('change', e => {
        const selected = courses.find(c => c.id == e.target.value);
        courseName.value = selected ? selected.courseName : '';
        courseUnit.value = selected ? selected.courseUnit : '';
    });

    // teacher
    const teachers = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
        ViewBag.TeachersList ?? new List<object>()
    ));

    const teacherSelect = document.getElementById('teacherSelect');
</script>