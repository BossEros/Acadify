@model ASI.Basecode.WebApp.ViewModels.ClassManagement.TeacherClassViewModel

@{
    ViewData["Title"] = $"{Model.CourseCode} - {Model.CourseName}";
    Layout = "_TeacherLayout";
}

<div class="container mt-4">
    <a asp-action="TeacherDashboard" class="text-decoration-none text-muted mb-3 d-inline-block">
        <i class="fa-solid fa-arrow-left me-1"></i> Back to Dashboard
    </a>

    <h3 class="fw-bold">@Model.CourseCode - @Model.CourseName</h3>
    <p class="text-muted mb-4">
        @Model.Schedule | @Model.Room | @Model.Units units
    </p>

    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-body">
            <h5 class="fw-semibold mb-3">Student Grades</h5>

            @if (Model.Students == null || !Model.Students.Any())
            {
                <div class="alert alert-info">
                    No students enrolled in this class yet.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-bordered align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>#</th>
                                <th>Student Name</th>
                                <th class="text-center">Midterm Grade</th>
                                <th class="text-center">Final Grade</th>
                                <th class="text-center">Remarks</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < Model.Students.Count; i++)
                            {
                                var s = Model.Students[i];
                                <tr>
                                    <td>@(i + 1)</td>
                                    <td>@s.StudentName</td>
                                    <td class="text-center">@s.MidtermGrade</td>
                                    <td class="text-center">@s.FinalGrade</td>
                                    <td class="text-center">
                                        @if (s.Remarks == "Passed")
                                        {
                                            <span class="badge bg-success">Passed</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">Failed</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
