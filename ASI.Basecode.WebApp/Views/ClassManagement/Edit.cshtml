@using ASI.Basecode.Services.DTOs
@model ASI.Basecode.Services.DTOs.ClassEditDTO
@{
    Layout = null;
}

<div id="validationSummaryEdit" class="hidden mb-4 p-4 rounded bg-red-100 text-red-700">
    <ul id="validationErrorsEdit" class="list-disc list-inside space-y-1"></ul>
</div>

<form asp-action="Edit" method="post" id="editClassForm" class="space-y-4">
    @Html.AntiForgeryToken()

    <input type="hidden" name="EDPCode" value="@Model.EDPCode" />
    
    <input type="hidden" name="Status" value="@(Model.Status.ToString().ToLower())" />

    <div>
        <label class="block text-sm text-gray-700 mb-1">EDP Code</label>
        <input value="@Model.EDPCode" readonly
               class="w-full rounded border border-gray-300 bg-gray-100 px-3 py-2 focus:ring-2 focus:ring-green-500 focus:outline-none" />
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
            <label class="block text-sm text-gray-700 mb-1">Course Code</label>
            <input value="@Model.CourseCode" readonly
                   class="w-full rounded border border-gray-200 bg-gray-100 px-3 py-2" />
        </div>
        <div>
            <label class="block text-sm text-gray-700 mb-1">Description</label>
            <input id="courseDescription" readonly 
                   value="@(Model.AllCourseMetadata.FirstOrDefault(c => c.CourseCode == Model.CourseCode)?.CourseName ?? "N/A")"
                   class="w-full rounded border border-gray-200 bg-gray-100 px-3 py-2" />
        </div>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-1 gap-4">
        <div>
            <label class="block text-sm text-gray-700 mb-1">Units</label>
            <input id="courseUnit" readonly 
                   value="@(Model.AllCourseMetadata.FirstOrDefault(c => c.CourseCode == Model.CourseCode)?.CourseUnit ?? 0)"
                   class="w-full rounded border border-gray-200 bg-gray-100 px-3 py-2" />
        </div>
    </div>

    <hr class="my-4 border-t border-gray-300" />

    <div class="space-y-4">
        <label class="block text-sm text-gray-700 font-semibold">Schedule</label>

        <div>
            <label class="block text-sm text-gray-700 mb-1">Days</label>

            <div class="flex flex-wrap gap-4">
                @foreach (var day in new[] { "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday" })
                {
                    var isChecked = Model.SelectedDays != null && Model.SelectedDays.Contains(day);

                    <label class="inline-flex items-center space-x-1 text-sm">
                        <input type="checkbox"
                            class="rounded border-gray-300 text-green-600 focus:ring-green-500"
                            id="@day"
                            name="SelectedDays"
                            value="@day"
                            @(isChecked ? "checked" : "") />
                        <span>@day</span>
                    </label>
                }
            </div>
        </div>

        <div>
            <label class="block text-sm text-gray-700 mb-1">Time</label>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">

                <div>
                    <label class="block text-sm text-gray-700 mb-1">Start Time</label>
                    <input type="time" id="startTimeEdit" name="StartTime" value="@Model.StartTime"
                        class="w-full rounded border border-gray-300 px-3 py-2
                                focus:ring-2 focus:ring-green-500 focus:outline-none" />
                </div>

                <div>
                    <label class="block text-sm text-gray-700 mb-1">End Time</label>
                    <input type="time" id="endTimeEdit" name="EndTime" value="@Model.EndTime"
                        class="w-full rounded border border-gray-300 px-3 py-2
                                focus:ring-2 focus:ring-green-500 focus:outline-none" />
                </div>

            </div>
        </div>

    </div>

    <hr class="my-4 border-t border-gray-300" />
    
    <div>
        <label class="block text-sm text-gray-700 mb-1 font-semibold">Teacher</label>
        <select id="teacherSelectEdit" name="TeacherId" asp-items="Model.TeacherOptions"
                class="w-full rounded border border-gray-300 px-3 py-2 focus:ring-2 focus:ring-green-500 focus:outline-none">
            <option disabled value="">Select a teacher</option>
        </select>
    </div>

    <div>
        <label class="block text-sm text-gray-700 mb-1">Capacity</label>
        <input type="number" name="Capacity" value="@Model.Capacity"
               class="w-full rounded border border-gray-300 px-3 py-2 focus:ring-2 focus:ring-green-500 focus:outline-none"
               placeholder="Enter maximum number of students" />
    </div>

    <div class="flex justify-end space-x-2 pt-2">
        <button type="button" class="px-4 py-2 bg-gray-200 text-gray-800 rounded hover:bg-gray-300" onclick="closeModal('modalEdit')">
            Cancel
        </button>
        <button type="submit" class="px-4 py-2 rounded bg-green-600 text-white hover:bg-green-700">
            Update
        </button>
    </div>
</form>

<script>
    window.currentCourses = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.AllCourseMetadata ?? new List<CourseMetadataDTO>()));
</script>
