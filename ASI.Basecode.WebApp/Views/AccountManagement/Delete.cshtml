@model ASI.Basecode.Services.DTOs.UserManagementDto
@{
    ViewData["Title"] = "Delete User";
}

<div class="max-w-2xl mx-auto bg-white p-6 rounded shadow">
    <h2 class="text-xl font-semibold mb-4 text-red-600">Delete User</h2>

    <div class="bg-red-50 border border-red-200 rounded p-4 mb-4">
        <p class="text-red-800 font-medium">Are you sure you want to delete this user?</p>
        <p class="text-red-600 text-sm mt-1">This action cannot be undone.</p>
    </div>

    <div class="space-y-3">
        <div>
            <label class="block font-medium text-gray-700">User ID:</label>
            <p class="text-gray-900">@Model.Id</p>
        </div>

        <div>
            <label class="block font-medium text-gray-700">Name:</label>
            <p class="text-gray-900">@Model.FullName</p>
        </div>

        <div>
            <label class="block font-medium text-gray-700">Email:</label>
            <p class="text-gray-900">@Model.Email</p>
        </div>

        <div>
            <label class="block font-medium text-gray-700">Role:</label>
            <p class="text-gray-900">@Model.Role</p>
        </div>

        <div>
            <label class="block font-medium text-gray-700">Status:</label>
            <p class="text-gray-900">@(Model.IsActive ? "Active" : "Inactive")</p>
        </div>
    </div>

    <form asp-action="Delete" method="post" class="mt-6">
        <input asp-for="Id" type="hidden" />
        
        <div class="flex space-x-2">
            <button type="submit" class="bg-red-600 hover:bg-red-700 text-white px-4 py-2 rounded">
                Delete User
            </button>
            <a asp-action="Index" class="bg-gray-500 hover:bg-gray-600 text-white px-4 py-2 rounded">
                Cancel
            </a>
        </div>
    </form>
</div>
