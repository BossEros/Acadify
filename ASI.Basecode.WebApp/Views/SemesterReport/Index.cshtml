@model ASI.Basecode.WebApp.ViewModels.SemesterReportViewModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Semester Report - @Model.StudentName</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        @@media print {
            .print-btn { display: none !important; }
            body { background: white; padding: 0; }
            .container { max-width: 100% !important; box-shadow: none; }
        }
    </style>
</head>
<body class="bg-gray-100 min-h-screen p-8">

    <div class="container mx-auto bg-white shadow-lg rounded-lg p-8 max-w-4xl">
        
        <div class="flex justify-between items-start mb-6 border-b pb-6">
            <div>
                <h1 class="text-3xl font-bold text-gray-800">Semester Report</h1>
                
                <h2 class="text-xl text-gray-600 mt-1">
                    @Model.SchoolYearRange - @Model.SemesterDescription
                </h2>
                
                <div class="mt-4 text-sm text-gray-700 space-y-1">
                    <p><span class="font-bold text-gray-900">Student Name:</span> @Model.StudentName</p>
                    <p><span class="font-bold text-gray-900">Student ID:</span> @Model.StudentIdNumber</p>
                    <p><span class="font-bold text-gray-900">Total Units Enrolled:</span> @Model.TotalUnits</p>
                </div>

                <p class="text-xs text-gray-400 mt-4">Generated on: @DateTime.Now.ToString("MMMM dd, yyyy hh:mm tt")</p>
            </div>
            
            <button onclick="window.print()" class="print-btn bg-blue-900 text-white px-6 py-2 rounded hover:opacity-90 font-medium flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm7-8V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" />
                </svg>
                Print Grade Slip
            </button>
        </div>

        <div class="grid grid-cols-4 gap-4 mb-8">
            <div class="bg-gray-50 p-4 rounded text-center border border-gray-200">
                <p class="text-sm text-gray-500 font-bold uppercase">Semester GPA</p>
                <p class="text-3xl font-bold text-gray-800">@Model.GPA.ToString("N2")</p>
            </div>
            
            <div class="bg-green-50 p-4 rounded text-center border border-green-100">
                <p class="text-sm text-green-600 font-bold uppercase">Passed</p>
                <p class="text-3xl font-bold text-green-700">@Model.SubjectsPassed</p>
            </div>

            <div class="bg-red-50 p-4 rounded text-center border border-red-100">
                <p class="text-sm text-red-600 font-bold uppercase">Failed</p>
                <p class="text-3xl font-bold text-red-700">@Model.SubjectsFailed</p>
            </div>

            <div class="bg-orange-50 p-4 rounded text-center border border-orange-100">
                <p class="text-sm text-orange-600 font-bold uppercase">Incomplete</p>
                <p class="text-3xl font-bold text-orange-700">@Model.SubjectsIncomplete</p>
            </div>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="border-b-2 border-gray-200">
                        <th class="py-3 px-4 text-sm font-bold text-gray-600 uppercase">Course Code</th>
                        <th class="py-3 px-4 text-sm font-bold text-gray-600 uppercase">Description</th>
                        <th class="py-3 px-4 text-sm font-bold text-gray-600 uppercase text-center">Units</th>
                        <th class="py-3 px-4 text-sm font-bold text-gray-600 uppercase text-center">Final Grade</th>
                        <th class="py-3 px-4 text-sm font-bold text-gray-600 uppercase text-center">Remark</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var grade in Model.Grades)
                    {
                        <tr class="border-b border-gray-100 hover:bg-gray-50">
                            <td class="py-3 px-4 text-gray-700 font-semibold">@grade.CourseCode</td>
                            <td class="py-3 px-4 text-gray-900 font-medium">@grade.CourseName</td>
                            <td class="py-3 px-4 text-center text-gray-700">@grade.Units</td>
                            <td class="py-3 px-4 text-center font-bold text-gray-900">
                                @(grade.FinalGrade?.ToString("0.00") ?? "--")
                            </td>
                            <td class="py-3 px-4 text-center">
                                @{
                                    var remark = (grade.Remark ?? "Incomplete").Trim();
                                    var colorClass = "bg-gray-100 text-gray-800"; // Default
                                    
                                    if (remark == "Passed") { colorClass = "text-green-800 bg-green-100"; }
                                    else if (remark == "Failed") { colorClass = "text-red-800 bg-red-100"; }
                                    else if (remark == "Incomplete") { colorClass = "text-orange-800 bg-orange-100"; }
                                }
                                <span class="px-3 py-1 rounded-full text-xs font-bold @colorClass">
                                    @remark.ToUpper()
                                </span>
                            </td>
                        </tr>
                    }
                    
                    @if (Model.Grades.Count == 0)
                    {
                        <tr>
                            <td colspan="5" class="py-6 text-center text-gray-500 italic">
                                No grades found for this semester.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

    </div>
</body>
</html>