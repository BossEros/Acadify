@model ASI.Basecode.Services.DTOs.ClassDetailsDTO

<div class="space-y-4">
    <div class="grid grid-cols-1 gap-y-2 gap-x-6 pb-4 border-b border-gray-100">
        <div>
            <p class="text-sm text-gray-500">EDP Code</p>
            <p class="font-medium text-gray-800">@Model.EDPCode</p>
        </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-y-2 gap-x-6 pb-4 border-b border-gray-100">
        <div>
            <p class="text-sm text-gray-500">Course Code</p>
            <p class="font-medium text-gray-800">@Model.CourseCode</p>
        </div>

        <div>
            <p class="text-sm text-gray-500">Description</p>
            <p class="font-medium text-gray-800">@Model.Description</p>
        </div>

        <div>
            <p class="text-sm text-gray-500">Units</p>
            <p class="font-medium text-gray-800">@Model.Units</p>
        </div>
    </div>

    <!--<div class="grid grid-cols-1 sm:grid-cols-2 gap-y-2 gap-x-6 pb-4 border-b border-gray-100">
        <div>
            <p class="text-sm text-gray-500">Semester</p>
            <p class="font-medium text-gray-800">@Model.Semester</p>
        </div>

        <div>
            <p class="text-sm text-gray-500">Year Level</p>
            <p class="font-medium text-gray-800">@Model.YearLevel</p>
        </div>
    </div> -->

    <div class="grid grid-cols-2 sm:grid-cols-4 gap-y-2 gap-x-6 pb-4 border-b border-gray-100">
        <div>
            <p class="text-sm text-gray-500">Schedule</p>
            <p class="font-medium text-gray-800">@Model.Schedule</p>
        </div>

        <div>
            <p class="text-sm text-gray-500">Capacity</p>
            <p class="font-medium text-gray-800">@Model.Capacity</p>
        </div>

        <div>
            <p class="text-sm text-gray-500">Date Created</p>
            <p class="font-medium text-gray-800">@Model.DateCreated.ToShortDateString()</p>
        </div>

        <div>
            <p class="text-sm text-gray-500">Status</p>
            @if (Model.Status)
            {
                <span class="inline-block px-3 py-1 rounded-full text-sm font-medium bg-green-100 text-green-700">
                    Active
                </span>
            }
            else
            {
                <span class="inline-block px-3 py-1 rounded-full text-sm font-medium bg-gray-200 text-gray-700">
                    Inactive
                </span>
            }
        </div>
    </div>

    <div class="grid grid-cols-1 gap-y-2 gap-x-6 pb-4">
        <div>
            <p class="text-sm text-gray-500">Teacher</p>
            <p class="font-medium text-gray-800">@Model.TeacherName</p>
        </div>
    </div>
    
    <h4 class="text-lg font-semibold border-b pt-4 pb-2 text-gray-700">Enrolled Students (@(Model.Enrollments?.Count ?? 0))</h4>
    
    @if (Model.Enrollments != null && Model.Enrollments.Any())
    {
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200">
                <thead class="bg-gray-50">
                    <tr>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">ID</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Last Name</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">First Name</th>
                    </tr>
                </thead>

                <tbody id="studentTbody" class="bg-white divide-y divide-gray-200">
                    @foreach (var student in Model.Enrollments.OrderBy(s => s.LastName))
                    {
                        <tr data-stud="@student.StudentId">
                            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">@student.StudentId</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-600">@student.LastName</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-600">@student.FirstName</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="flex items-center justify-center gap-4 mt-4 py-3">
            <button id="studPrevPage"
                class="p-2 rounded hover:bg-gray-100 disabled:opacity-50 disabled:cursor-not-allowed"
                disabled>
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                </svg>
            </button>

            <div class="flex items-center gap-2">
                <input type="number"
                    id="studPageInput"
                    min="1"
                    value="1"
                    class="w-16 text-center border border-gray-300 rounded px-2 py-1 focus:outline-none focus:ring-2 focus:ring-blue-500" />
                <span class="text-gray-600">of</span>
                <span id="studTotalPages" class="text-gray-600 font-medium">1</span>
            </div>

            <button id="studNextPage"
                class="p-2 rounded hover:bg-gray-100 disabled:opacity-50 disabled:cursor-not-allowed">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
            </button>
        </div>
    }
    else
    {
        <p class="text-gray-500 text-sm italic">No students are currently enrolled in this class.</p>
    }

    <div class="flex justify-end pt-4 border-t">
        <button type="button" 
                class="px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700"
                onclick="closeModal('modalDetails')">
            Close
        </button>
    </div>
</div>

<script>
(function() {
    const PAGE_SIZE = 5;
    let currentPage = 1;
    let allRows = [];
    let filteredRows = [];

    function initStudentPagination() {
        const tbody = document.querySelector('#studentTbody');
        if (!tbody) return;

        allRows = Array.from(tbody.querySelectorAll('tr[data-stud]'));
        filteredRows = [...allRows];

        renderStudentPage();
    }

    function renderStudentPage() {
        const tbody = document.querySelector('#studentTbody');
        if (!tbody) return;
        
        tbody.innerHTML = '';

        const totalPages = Math.ceil(filteredRows.length / PAGE_SIZE);

        const start = (currentPage - 1) * PAGE_SIZE;
        const end = Math.min(start + PAGE_SIZE, filteredRows.length);

        for (let i = start; i < end; i++) {
            tbody.appendChild(filteredRows[i].cloneNode(true));
        }

        updateStudentControls(totalPages);
    }

    function updateStudentControls(totalPages) {
        const totalPagesEl = document.querySelector('#studTotalPages');
        const pageInputEl = document.querySelector('#studPageInput');
        const prevBtn = document.querySelector('#studPrevPage');
        const nextBtn = document.querySelector('#studNextPage');

        if (!totalPagesEl || !pageInputEl || !prevBtn || !nextBtn) return;

        totalPagesEl.textContent = totalPages;
        pageInputEl.value = currentPage;
        pageInputEl.max = totalPages;

        prevBtn.disabled = currentPage === 1;
        nextBtn.disabled = currentPage === totalPages || totalPages === 0;
    }

    function studentGoToPage(page) {
        const totalPages = Math.ceil(filteredRows.length / PAGE_SIZE);
        if (page < 1) page = 1;
        if (page > totalPages) page = totalPages || 1;

        currentPage = page;
        renderStudentPage();
    }

    const prevBtn = document.querySelector('#studPrevPage');
    const nextBtn = document.querySelector('#studNextPage');
    const pageInput = document.querySelector('#studPageInput');

    if (prevBtn) {
        prevBtn.addEventListener('click', function() {
            studentGoToPage(currentPage - 1);
        });
    }

    if (nextBtn) {
        nextBtn.addEventListener('click', function() {
            studentGoToPage(currentPage + 1);
        });
    }

    if (pageInput) {
        pageInput.addEventListener('keypress', function(e) {
            if (e.key === 'Enter') {
                const page = parseInt(e.target.value);
                if (!isNaN(page)) studentGoToPage(page);
            }
        });

        pageInput.addEventListener('blur', function(e) {
            const page = parseInt(e.target.value);
            if (!isNaN(page)) {
                studentGoToPage(page);
            } else {
                e.target.value = currentPage;
            }
        });
    }

    initStudentPagination();
})();
</script>
