@model ASI.Basecode.WebApp.ViewModels.AccountManagement.UserListViewModel
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Account Management";
}

<div class="flex flex-col space-y-4">
    @if (!string.IsNullOrEmpty(Model.Message))
    {
        <div class="p-4 rounded @(Model.MessageType == "success" ? "bg-green-100 text-green-700" : "bg-red-100 text-red-700")">
            @Model.Message
        </div>
    }

    <div class="flex items-start justify-between">
        <div>
            <h1 class="text-2xl font-semibold">Account Management</h1>
            <p class="text-gray-500">Manage user accounts</p>
        </div>
        <div class="w-72">
            <label class="sr-only" for="searchUserId">Search by User ID or Email</label>
            <div class="relative">
                <input id="searchUserId" type="text" placeholder="Search by User ID or Email" class="w-full rounded border border-gray-300 pl-3 pr-10 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500" />
                <button type="button" id="btnSearchGlobal" class="absolute right-1 top-1/2 -translate-y-1/2 text-gray-600 hover:text-gray-800 p-1" aria-label="Search">
                    <span class="material-icons"></span>
                </button>
            </div>
        </div>
    </div>

    <div class="flex items-center space-x-3">
        <button type="button" id="openEnroll" class="bg-green-600 hover:bg-green-700 text-white px-4 py-2 rounded">Enroll Student</button>
        <button type="button" id="openUnenroll" class="bg-red-600 hover:bg-red-700 text-white px-4 py-2 rounded">Unenroll Student</button>
        <button type="button" id="openAssign" class="bg-purple-600 hover:bg-purple-700 text-white px-4 py-2 rounded">Assign Teacher</button>
        <button type="button" id="openUnassign" class="bg-yellow-600 hover:bg-yellow-700 text-white px-4 py-2 rounded">Unassign Teacher</button>
        <button type="button" id="openEdit" class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded">Edit User</button>
    </div>

    <div class="bg-white rounded-lg shadow p-4">
        <table class="w-full border-collapse">
            <thead class="bg-gray-50">
                <tr>
                    <th class="p-3 text-left text-xs font-semibold text-gray-600">USER ID</th>
                    <th class="p-3 text-left text-xs font-semibold text-gray-600">FIRST NAME</th>
                    <th class="p-3 text-left text-xs font-semibold text-gray-600">LAST NAME</th>
                    <th class="p-3 text-left text-xs font-semibold text-gray-600">EMAIL ADDRESS</th>
                    <th class="p-3 text-left text-xs font-semibold text-gray-600">ROLE</th>
                    <th class="p-3 text-left text-xs font-semibold text-gray-600">STATUS</th>
                </tr>
            </thead>
            <tbody id="usersTbody">
                @foreach (var user in Model.Users)
                {
                    <tr class="border-b" data-user-id="@user.Id.ToString("D6")" data-email="@(user.Email?.ToLower() ?? "")">
                        <td class="p-3">@user.Id.ToString("D6")</td>
                        <td class="p-3">@user.FirstName</td>
                        <td class="p-3">@user.LastName</td>
                        <td class="p-3">@(user.Email ?? "")</td>
                        <td class="p-3">@user.Role</td>
                        <td class="p-3">
                            @if (user.IsActive)
                            {
                                <span class="inline-block rounded-full bg-green-100 text-green-700 text-xs px-2 py-1">Active</span>
                            }
                            else
                            {
                                <span class="inline-block rounded-full bg-red-100 text-red-700 text-xs px-2 py-1">Inactive</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <!-- Pagination Controls -->
        <div class="flex items-center justify-center gap-4 mt-4 py-3">
            <button id="prevPage" class="p-2 rounded hover:bg-gray-100 disabled:opacity-50 disabled:cursor-not-allowed" disabled>
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
                </svg>
            </button>
            
            <div class="flex items-center gap-2">
                <input 
                    type="number" 
                    id="pageInput" 
                    min="1" 
                    value="1" 
                    class="w-16 text-center border border-gray-300 rounded px-2 py-1 focus:outline-none focus:ring-2 focus:ring-blue-500"
                />
                <span class="text-gray-600">of</span>
                <span id="totalPages" class="text-gray-600 font-medium">1</span>
            </div>
            
            <button id="nextPage" class="p-2 rounded hover:bg-gray-100 disabled:opacity-50 disabled:cursor-not-allowed">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                </svg>
            </button>
        </div>
    </div>

    @Html.AntiForgeryToken()

    <!-- Enroll Student Modal -->
    <div id="modalEnroll" class="hidden fixed inset-0 z-50 items-center justify-center bg-gray-900/50 backdrop-blur">
        <div class="bg-white w-full max-w-lg rounded-xl shadow p-6">
            <h3 class="text-xl font-semibold mb-4">Enroll Student</h3>
            <form id="formEnroll" class="space-y-4">
                <div>
                    <label class="block text-sm text-gray-700 mb-1">User ID</label>
                    <input name="UserId" type="number" class="w-full rounded border border-gray-300 px-3 py-2" placeholder="Enter User ID" required />
                </div>
                <div>
                    <label class="block text-sm text-gray-700 mb-1">EDP Code</label>
                    <input name="EdpCode" type="text" class="w-full rounded border border-gray-300 px-3 py-2" placeholder="Enter EDP Code" required />
                </div>
                <div class="flex justify-end space-x-2 pt-2">
                    <button type="button" data-close="modalEnroll" class="px-4 py-2 rounded border">Cancel</button>
                    <button type="submit" class="px-4 py-2 rounded bg-green-600 text-white">Enroll Student</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Unenroll Student Modal -->
    <div id="modalUnenroll" class="hidden fixed inset-0 z-50 items-center justify-center bg-gray-900/50 backdrop-blur">
        <div class="bg-white w-full max-w-lg rounded-xl shadow p-6">
            <h3 class="text-xl font-semibold mb-4">Unenroll Student</h3>
            <form id="formUnenroll" class="space-y-4">
                <div>
                    <label class="block text-sm text-gray-700 mb-1">User ID</label>
                    <div class="flex space-x-2">
                        <input id="unenrollUserId" name="UserId" type="number" class="flex-1 rounded border border-gray-300 px-3 py-2" placeholder="Enter User ID" required />
                        <button type="button" id="btnLoadClasses" class="px-3 py-2 rounded bg-gray-800 text-white">Load Classes</button>
                    </div>
                </div>
                <div>
                    <label class="block text-sm text-gray-700 mb-1">Enrolled Classes</label>
                    <select name="EdpCode" id="enrolledClassesDropdown" class="w-full rounded border border-gray-300 px-3 py-2" required disabled>
                        <option value="">Enter User ID and click Load Classes</option>
                    </select>
                </div>
                <div class="flex justify-end space-x-2 pt-2">
                    <button type="button" data-close="modalUnenroll" class="px-4 py-2 rounded border">Cancel</button>
                    <button type="submit" class="px-4 py-2 rounded bg-red-600 text-white">Unenroll Student</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Assign Teacher Modal -->
    <div id="modalAssign" class="hidden fixed inset-0 z-50 items-center justify-center bg-gray-900/50 backdrop-blur">
        <div class="bg-white w-full max-w-lg rounded-xl shadow p-6">
            <h3 class="text-xl font-semibold mb-4">Assign Teacher</h3>
            <form id="formAssign" class="space-y-4">
                <div>
                    <label class="block text-sm text-gray-700 mb-1">User ID</label>
                    <input name="UserId" type="number" class="w-full rounded border border-gray-300 px-3 py-2" placeholder="Enter User ID" required />
                </div>
                <div>
                    <label class="block text-sm text-gray-700 mb-1">EDP Code</label>
                    <input name="EdpCode" type="text" class="w-full rounded border border-gray-300 px-3 py-2" placeholder="Enter EDP Code" required />
                </div>
                <div class="flex justify-end space-x-2 pt-2">
                    <button type="button" data-close="modalAssign" class="px-4 py-2 rounded border">Cancel</button>
                    <button type="submit" class="px-4 py-2 rounded bg-purple-600 text-white">Assign Teacher</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Unassign Teacher Modal -->
    <div id="modalUnassign" class="hidden fixed inset-0 z-50 items-center justify-center bg-gray-900/50 backdrop-blur">
        <div class="bg-white w-full max-w-lg rounded-xl shadow p-6">
            <h3 class="text-xl font-semibold mb-4">Unassign Teacher</h3>
            <form id="formUnassign" class="space-y-4">
                <div>
                    <label class="block text-sm text-gray-700 mb-1">User ID</label>
                    <div class="flex space-x-2">
                        <input id="unassignUserId" name="UserId" type="number" class="flex-1 rounded border border-gray-300 px-3 py-2" placeholder="Enter User ID" required />
                        <button type="button" id="btnLoadTeacherClasses" class="px-3 py-2 rounded bg-gray-800 text-white">Load Classes</button>
                    </div>
                </div>
                <div>
                    <label class="block text-sm text-gray-700 mb-1">Assigned Classes</label>
                    <select name="EdpCode" id="assignedClassesDropdown" class="w-full rounded border border-gray-300 px-3 py-2" required disabled>
                        <option value="">Enter User ID and click Load Classes</option>
                    </select>
                </div>
                <div class="flex justify-end space-x-2 pt-2">
                    <button type="button" data-close="modalUnassign" class="px-4 py-2 rounded border">Cancel</button>
                    <button type="submit" class="px-4 py-2 rounded bg-yellow-600 text-white">Unassign Teacher</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Edit User Modal -->
    <div id="modalEdit" class="hidden fixed inset-0 z-50 items-center justify-center bg-gray-900/50 backdrop-blur">
        <div class="bg-white w-full max-w-lg rounded-xl shadow p-6">
            <h3 class="text-xl font-semibold mb-4">Edit User</h3>
            <form id="formEdit" class="space-y-4">
                <div>
                    <label class="block text-sm text-gray-700 mb-1">Find User by ID</label>
                    <div class="flex space-x-2">
                        <input id="editSearchUserId" type="number" class="flex-1 rounded border border-gray-300 px-3 py-2" placeholder="Enter User ID" />
                        <button type="button" id="btnEditFind" class="px-3 py-2 rounded bg-gray-800 text-white">Find</button>
                    </div>
                </div>
                <hr />
                <input type="hidden" name="UserId" id="editUserIdHidden" />
                <div>
                    <label class="block text-sm text-gray-700 mb-1">First Name</label>
                    <input id="editFirstName" type="text" class="w-full rounded border border-gray-300 px-3 py-2" disabled />
                </div>
                <div>
                    <label class="block text-sm text-gray-700 mb-1">Last Name</label>
                    <input id="editLastName" type="text" class="w-full rounded border border-gray-300 px-3 py-2" disabled />
                </div>
                <div>
                    <label class="block text-sm text-gray-700 mb-1">Email</label>
                    <input name="Email" id="editEmail" type="email" class="w-full rounded border border-gray-300 px-3 py-2" />
                </div>
                <div>
                    <label class="block text-sm text-gray-700 mb-1">Role</label>
                    <input id="editRole" type="text" class="w-full rounded border border-gray-300 px-3 py-2" disabled />
                </div>
                <div>
                    <label class="block text-sm text-gray-700 mb-1">Status</label>
                    <select name="IsActive" id="editStatus" class="w-full rounded border border-gray-300 px-3 py-2">
                        <option value="true">Active</option>
                        <option value="false">Inactive</option>
                    </select>
                </div>
                <div class="flex justify-end space-x-2 pt-2">
                    <button type="button" data-close="modalEdit" class="px-4 py-2 rounded border">Cancel</button>
                    <button type="submit" class="px-4 py-2 rounded bg-blue-600 text-white">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    (function () {
        const qs = (s) => document.querySelector(s);
        const qsa = (s) => document.querySelectorAll(s);

        // Pagination variables
        const PAGE_SIZE = 20;
        let currentPage = 1;
        let allRows = [];
        let filteredRows = [];

        // Helper functions
        function openModal(id) {
            qs('#' + id).classList.remove('hidden');
            qs('#' + id).classList.add('flex');
        }
        function closeModal(id) {
            qs('#' + id).classList.add('hidden');
            qs('#' + id).classList.remove('flex');
        }

        async function postForm(url, data) {
            const token = qs('input[name="__RequestVerificationToken"]').value;
            const res = await fetch(url, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
                body: JSON.stringify(data)
            });
            return res.json();
        }

        async function findUser(userId) {
            const res = await fetch(`@Url.Action("FindUser")?userId=${encodeURIComponent(userId)}`);
            return res.json();
        }

        // Pagination functions
        function initializePagination() {
            const tbody = qs('#usersTbody');
            allRows = Array.from(tbody.querySelectorAll('tr[data-user-id]'));
            filteredRows = [...allRows];
            renderPage();
        }

        function renderPage() {
            const tbody = qs('#usersTbody');
            const totalPages = Math.ceil(filteredRows.length / PAGE_SIZE);
            
            // Clear tbody
            tbody.innerHTML = '';
            
            // Calculate start and end indices
            const startIdx = (currentPage - 1) * PAGE_SIZE;
            const endIdx = Math.min(startIdx + PAGE_SIZE, filteredRows.length);
            
            // Add rows for current page
            if (filteredRows.length === 0) {
                tbody.innerHTML = '<tr><td colspan="6" class="text-center text-gray-500 py-3">No users found.</td></tr>';
            } else {
                for (let i = startIdx; i < endIdx; i++) {
                    tbody.appendChild(filteredRows[i].cloneNode(true));
                }
            }
            
            // Update pagination controls
            updatePaginationControls(totalPages);
        }

        function updatePaginationControls(totalPages) {
            const prevBtn = qs('#prevPage');
            const nextBtn = qs('#nextPage');
            const pageInput = qs('#pageInput');
            const totalPagesSpan = qs('#totalPages');
            
            totalPagesSpan.textContent = totalPages;
            pageInput.value = currentPage;
            pageInput.max = totalPages;
            
            prevBtn.disabled = currentPage === 1;
            nextBtn.disabled = currentPage === totalPages || totalPages === 0;
        }

        function goToPage(page) {
            const totalPages = Math.ceil(filteredRows.length / PAGE_SIZE);
            if (page < 1) page = 1;
            if (page > totalPages) page = totalPages;
            if (totalPages === 0) page = 1;
            
            currentPage = page;
            renderPage();
        }

        // Pagination event listeners
        qs('#prevPage').addEventListener('click', () => {
            goToPage(currentPage - 1);
        });

        qs('#nextPage').addEventListener('click', () => {
            goToPage(currentPage + 1);
        });

        qs('#pageInput').addEventListener('keypress', (e) => {
            if (e.key === 'Enter') {
                const page = parseInt(e.target.value);
                if (!isNaN(page)) {
                    goToPage(page);
                }
            }
        });

        qs('#pageInput').addEventListener('blur', (e) => {
            const page = parseInt(e.target.value);
            if (!isNaN(page)) {
                goToPage(page);
            } else {
                e.target.value = currentPage;
            }
        });

        // Modal controls
        qs('#openEnroll').addEventListener('click', () => openModal('modalEnroll'));
        qs('#openUnenroll').addEventListener('click', () => openModal('modalUnenroll'));
        qs('#openAssign').addEventListener('click', () => openModal('modalAssign'));
        qs('#openUnassign').addEventListener('click', () => openModal('modalUnassign'));
        qs('#openEdit').addEventListener('click', () => openModal('modalEdit'));

        qsa('[data-close]').forEach(btn => {
            btn.addEventListener('click', () => closeModal(btn.dataset.close));
        });

        qsa('[id^="modal"]').forEach(m => {
            m.addEventListener('click', e => { if (e.target === m) closeModal(m.id); });
        });

        // Enroll
        qs('#formEnroll').addEventListener('submit', async (e) => {
            e.preventDefault();
            const data = Object.fromEntries(new FormData(e.target).entries());
            const result = await postForm('@Url.Action("EnrollStudent")', data);
            alert(result.message);
            if (result.success) { location.reload(); }
        });

        // Unenroll - Load Classes
        qs('#btnLoadClasses').addEventListener('click', async () => {
            const userId = qs('#unenrollUserId').value;
            if (!userId) {
                alert('Please enter a User ID');
                return;
            }

            // Fetch enrolled classes for the student
            const res = await fetch(`@Url.Action("GetEnrolledClasses")?userId=${encodeURIComponent(userId)}`);
            const result = await res.json();

            const dropdown = qs('#enrolledClassesDropdown');
            dropdown.innerHTML = '';

            if (!result.success || !result.data || result.data.length === 0) {
                dropdown.innerHTML = '<option value="">No enrolled classes found</option>';
                dropdown.disabled = true;
                alert(result.message || 'No enrolled classes found for this student');
                return;
            }

            dropdown.disabled = false;
            dropdown.innerHTML = '<option value="">Select a class to unenroll</option>';
            result.data.forEach(cls => {
                const option = document.createElement('option');
                option.value = cls.edpCode;
                option.textContent = `${cls.edpCode} - ${cls.className || ''}`;
                dropdown.appendChild(option);
            });
        });

        // Unenroll - Submit
        qs('#formUnenroll').addEventListener('submit', async (e) => {
            e.preventDefault();
            const data = Object.fromEntries(new FormData(e.target).entries());
            const result = await postForm('@Url.Action("UnenrollStudent")', data);
            alert(result.message);
            if (result.success) { location.reload(); }
        });

        // Assign
        qs('#formAssign').addEventListener('submit', async (e) => {
            e.preventDefault();
            const data = Object.fromEntries(new FormData(e.target).entries());
            const result = await postForm('@Url.Action("AssignTeacher")', data);
            alert(result.message);
            if (result.success) { location.reload(); }
        });

        // Unassign - Load Teacher Classes
        qs('#btnLoadTeacherClasses').addEventListener('click', async () => {
            const userId = qs('#unassignUserId').value;
            if (!userId) {
                alert('Please enter a User ID');
                return;
            }

            // Fetch assigned classes for the teacher
            const res = await fetch(`@Url.Action("GetAssignedClasses")?userId=${encodeURIComponent(userId)}`);
            const result = await res.json();

            const dropdown = qs('#assignedClassesDropdown');
            dropdown.innerHTML = '';

            if (!result.success || !result.data || result.data.length === 0) {
                dropdown.innerHTML = '<option value="">No assigned classes found</option>';
                dropdown.disabled = true;
                alert(result.message || 'No assigned classes found for this teacher');
                return;
            }

            dropdown.disabled = false;
            dropdown.innerHTML = '<option value="">Select a class to unassign</option>';
            result.data.forEach(cls => {
                const option = document.createElement('option');
                option.value = cls.edpCode;
                option.textContent = `${cls.edpCode} - ${cls.className || ''}`;
                dropdown.appendChild(option);
            });
        });

        // Unassign - Submit
        qs('#formUnassign').addEventListener('submit', async (e) => {
            e.preventDefault();
            const data = Object.fromEntries(new FormData(e.target).entries());
            const result = await postForm('@Url.Action("UnassignTeacher")', data);
            alert(result.message);
            if (result.success) { location.reload(); }
        });

        // Edit - search
        qs('#btnEditFind').addEventListener('click', async () => {
            const userId = qs('#editSearchUserId').value;
            if (!userId) return;
            const u = await findUser(userId);
            if (!u || !u.success) { alert(u?.message || 'User not found'); return; }
            qs('#editFirstName').value = u.data.firstName;
            qs('#editLastName').value = u.data.lastName;
            qs('#editEmail').value = u.data.email;
            qs('#editRole').value = u.data.role;
            qs('#editUserIdHidden').value = u.data.id;
            qs('#editStatus').value = u.data.isActive.toString().toLowerCase();
        });

        // Edit - submit
        qs('#formEdit').addEventListener('submit', async (e) => {
            e.preventDefault();
            const userId = qs('#editUserIdHidden').value;
            if (!userId) {
                alert('Please search for a user first.');
                return;
            }
            const formData = Object.fromEntries(new FormData(e.target).entries());
            const data = {
                UserId: parseInt(formData.UserId),
                Email: formData.Email,
                IsActive: formData.IsActive === 'true'
            };
            const result = await postForm('@Url.Action("EditUser")', data);
            alert(result.message);
            if (result.success) { location.reload(); }
        });

        // Global Search by User ID or Email
        qs('#searchUserId').addEventListener('input', (e) => {
            const searchTerm = e.target.value.trim().toLowerCase();
            
            if (!searchTerm) {
                // Reset to all rows
                filteredRows = [...allRows];
            } else {
                // Filter rows based on User ID or Email
                filteredRows = allRows.filter(row => {
                    const userId = row.dataset.userId?.toLowerCase() || '';
                    const email = row.dataset.email?.toLowerCase() || '';
                    return userId.includes(searchTerm) || email.includes(searchTerm);
                });
            }
            
            // Reset to page 1 when searching
            currentPage = 1;
            renderPage();
        });

        // Initialize pagination on page load
        initializePagination();
    })();
</script>

<style>
    /* Hide spinner arrows in number input */
    #pageInput::-webkit-outer-spin-button,
    #pageInput::-webkit-inner-spin-button {
        -webkit-appearance: none;
        margin: 0;
    }
    #pageInput[type=number] {
        -moz-appearance: textfield;
    }
</style>