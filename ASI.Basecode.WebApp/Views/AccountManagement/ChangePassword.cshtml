@model ASI.Basecode.WebApp.ViewModels.AccountManagement.ChangePasswordViewModel
@{
    ViewData["Title"] = "Change Password";
}

<div class="max-w-2xl mx-auto bg-white p-6 rounded shadow">
    <h2 class="text-xl font-semibold mb-4">Change Password for @Model.FirstName @Model.LastName</h2>

    <form asp-action="ChangePassword" method="post" class="space-y-4">
        <input asp-for="UserId" type="hidden" />

        <div>
            <label asp-for="UserName" class="block font-medium"></label>
            <input asp-for="UserName" class="w-full border rounded px-3 py-2 bg-gray-100" readonly />
        </div>

        <div>
            <label asp-for="NewPassword" class="block font-medium"></label>
            <input asp-for="NewPassword" type="password" class="w-full border rounded px-3 py-2" />
            <span asp-validation-for="NewPassword" class="text-red-500 text-sm"></span>
        </div>

        <div>
            <label asp-for="ConfirmNewPassword" class="block font-medium"></label>
            <input asp-for="ConfirmNewPassword" type="password" class="w-full border rounded px-3 py-2" />
            <span asp-validation-for="ConfirmNewPassword" class="text-red-500 text-sm"></span>
        </div>

        <div class="flex space-x-2">
            <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded">
                Change Password
            </button>
            <a asp-action="Index" class="bg-gray-500 hover:bg-gray-600 text-white px-4 py-2 rounded">
                Cancel
            </a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
