@using ASI.Basecode.Data.Models
@using System.Text.Json
@model List<ASI.Basecode.WebApp.ViewModels.SemesterGradesViewModel>
@{
    ViewData["Title"] = "My Grades";
    Layout = "_Layout";

    var sectionKeys = Model
        .Select(m => new { m.SchoolYearStart, m.Semester })
        .Select(x => $"{x.SchoolYearStart}_{x.Semester}")
        .Distinct()
        .ToList();

    var schoolYears = Model
        .Select(m => m.SchoolYearStart)
        .Distinct()
        .OrderByDescending(s => s)
        .ToList();

    var firstSection = Model.FirstOrDefault();
}
<div class="container mx-auto px-4 py-6">
    <div class="bg-white rounded-lg shadow p-6">
        <div class="flex justify-between items-center mb-2">
            <div>
                <h2 class="text-2xl font-semibold text-gray-800">My Grades</h2>
            </div>
            
            <a id="printReportBtn" href="#" target="_blank" class="bg-[#3A4D75] text-white px-4 py-2 rounded-lg flex items-center space-x-2 hover:opacity-90 transition">
                <span>Semester Report</span>
            </a>
        </div>

        <div class="mb-6 border-b pb-4">
            <div class="flex flex-wrap gap-4 items-center">
                <div>
                    <label for="schoolYearSelect" class="block text-sm text-gray-600 mb-1">School Year</label>
                    <select id="schoolYearSelect" class="px-4 py-2 rounded-lg border bg-white" onchange="applyFilters()">
                        @if (!schoolYears.Any())
                        {
                            <option value="">-- No school year --</option>
                        }
                        else
                        {
                            foreach (var sy in schoolYears)
                            {
                                <option value="@sy">S.Y. @sy-@(@sy + 1)</option>
                            }
                        }
                    </select>
                </div>

                <div>
                    <label for="semesterSelect" class="block text-sm text-gray-600 mb-1">Semester</label>
                    <select id="semesterSelect" class="px-4 py-2 rounded-lg border bg-white" onchange="applyFilters()">
                        <option value="1">1st Semester</option>
                        <option value="2">2nd Semester</option>
                    </select>
                </div>
            </div>
        </div>

        <div id="noGradesMessage" class="mb-6 bg-yellow-50 rounded-lg p-4 text-gray-700 hidden">
            No grades available for the selected School Year / Semester.
        </div>

        @foreach (var sem in Model)
        {
            <div id="semester_@(sem.SchoolYearStart)_@(sem.Semester)" class="mb-8 semester-section hidden">
                <h3 class="text-xl font-semibold mb-4">
                    @{
                        var schoolYearDisplay = $"S.Y. {sem.SchoolYearStart}-{sem.SchoolYearStart + 1}";
                        var semesterOrdinal = sem.Semester == 1 ? "1st" : "2nd";
                    }
                    @schoolYearDisplay - @semesterOrdinal Semester
                </h3>

                @if (!sem.Grades.Any())
                {
                    <div class="bg-gray-50 rounded-lg p-4 text-gray-600">
                        No grades available for this semester.
                    </div>
                }
                else
                {
                    <div class="overflow-x-auto">
                        <table class="min-w-full">
                            <thead>
                                <tr class="border-b">
                                    <th class="text-left py-3 px-4 text-sm font-medium text-gray-600">Subject Code</th>
                                    <th class="text-left py-3 px-4 text-sm font-medium text-gray-600">Subject Name</th>
                                    <th class="text-center py-3 px-4 text-sm font-medium text-gray-600">Units</th>
                                    <th class="text-center py-3 px-4 text-sm font-medium text-gray-600">Midterm</th>
                                    <th class="text-center py-3 px-4 text-sm font-medium text-gray-600">Final</th>
                                    <th class="text-center py-3 px-4 text-sm font-medium text-gray-600">Remark</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var grade in sem.Grades)
                                {
                                    <tr class="border-b hover:bg-gray-50">
                                        <td class="py-3 px-4">@grade.CourseCode</td>
                                        <td class="py-3 px-4 text-blue-600">@grade.CourseName</td>
                                        <td class="py-3 px-4 text-center">@grade.Units</td>
                                        <td class="py-3 px-4 text-center">@(grade.MidtermGrade?.ToString("0.00") ?? "--")</td>
                                        <td class="py-3 px-4 text-center">@(grade.FinalGrade?.ToString("0.00") ?? "--")</td>
                                        <td class="py-3 px-4 text-center">
                                            @{
                                                var remarkText = (grade.Remark ?? string.Empty).Trim();
                                                var remarkLower = remarkText.ToLowerInvariant();
                                                var badgeText = string.IsNullOrEmpty(remarkText) ? "Incomplete" : remarkText;

                                                string textClass, bgClass;
                                                if (remarkLower == "failed" || remarkLower == "fail")
                                                {
                                                    textClass = "text-red-700";
                                                    bgClass = "bg-red-100";
                                                }
                                                else if (remarkLower == "passed")
                                                {
                                                    textClass = "text-green-700";
                                                    bgClass = "bg-green-100";
                                                }
                                                else
                                                {
                                                    textClass = "text-orange-700";
                                                    bgClass = "bg-orange-100";
                                                }
                                            }
                                            <span class="px-3 py-1 text-sm font-semibold rounded-full @textClass @bgClass">
                                                @badgeText
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        const existingSections = @Html.Raw(JsonSerializer.Serialize(sectionKeys));

        function applyFilters() {
            const schoolYear = document.getElementById('schoolYearSelect').value;
            const sem = document.getElementById('semesterSelect').value;
            
            showSelected(schoolYear, sem);
            updatePrintButton(schoolYear, sem);
        }

        function showSelected(schoolYear, semester) {
            document.querySelectorAll('.semester-section').forEach(section => section.classList.add('hidden'));

            const key = `${schoolYear}_${semester}`;
            const target = document.getElementById(`semester_${schoolYear}_${semester}`);

            if (existingSections.includes(key) && target) {
                target.classList.remove('hidden');
                document.getElementById('noGradesMessage').classList.add('hidden');
            } else {
                document.getElementById('noGradesMessage').classList.remove('hidden');
            }
        }

        function updatePrintButton(schoolYear, semester) {
            const btn = document.getElementById('printReportBtn');
            if (btn) {
                const baseUrl = '@Url.Action("Index", "SemesterReport")';
                // Updated query param name to reflect school year start
                btn.href = `${baseUrl}?semester=${semester}&schoolYearStart=${encodeURIComponent(schoolYear)}`;
            }
        }

        document.addEventListener('DOMContentLoaded', function() {
            @if (firstSection != null)
            {
                <text>
                document.getElementById('schoolYearSelect').value = '@firstSection.SchoolYearStart';
                document.getElementById('semesterSelect').value = '@firstSection.Semester';
                applyFilters();
                </text>
            }
            else
            {
                <text>
                document.getElementById('noGradesMessage').classList.remove('hidden');
                updatePrintButton('', 1);
                </text>
            }
        });
    </script>
}