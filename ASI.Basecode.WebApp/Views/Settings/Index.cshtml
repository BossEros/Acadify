@{
    ViewData["Title"] = "Settings";
    Layout = "_TeacherLayout";
}

<div class="container mt-4">
    <h2 class="fw-bold mb-4">Account Settings</h2>

    <div class="row">
        <!-- User Details -->
        <div class="col-md-6 mb-4">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-body">
                    <h5 class="fw-semibold mb-3">User Details</h5>
                    <div class="mb-3">
                        <label class="form-label fw-medium">Name</label>
                        <input type="text" class="form-control" value="@User.FindFirst(System.Security.Claims.ClaimTypes.GivenName)?.Value" readonly />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-medium">User ID</label>
                        <input type="text" class="form-control" value="@User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value" readonly />
                    </div>
                </div>
            </div>
        </div>

        <!-- Change Password -->
        <div class="col-md-6 mb-4">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-body">
                    <h5 class="fw-semibold mb-3">Change Password</h5>
                    <form asp-controller="Settings" asp-action="ChangePassword" method="post">
                        @Html.AntiForgeryToken()
                        <div class="mb-3">
                            <label class="form-label">Current Password</label>
                            <input type="password" name="CurrentPassword" class="form-control" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">New Password</label>
                            <input type="password" name="NewPassword" class="form-control" minlength="8" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Confirm New Password</label>
                            <input type="password" name="ConfirmNewPassword" class="form-control" minlength="8" required />
                        </div>
                        <button type="submit" class="btn btn-primary w-100 mt-2">Change Password</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Delete Account -->
    <div class="card border-0 shadow-sm rounded-3 mt-3">
        <div class="card-body">
            <h5 class="fw-semibold mb-3 text-danger">Delete Account</h5>
            <p class="text-muted mb-3">This will permanently delete your account and all associated data. This action cannot be undone.</p>
            <form asp-controller="Settings" asp-action="DeleteAccount" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-danger">Delete Account</button>
            </form>
        </div>
    </div>
</div>
