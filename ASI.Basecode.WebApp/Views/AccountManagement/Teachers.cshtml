@model ASI.Basecode.WebApp.ViewModels.AccountManagement.UserListViewModel
@{
    ViewData["Title"] = "Teacher Management";
    Layout = "_AdminLayout";
}

<div class="container mx-auto px-4 py-8">
    <div class="mb-6">
        <h1 class="text-2xl font-bold text-gray-800">Teacher Management</h1>
        <p class="text-gray-600">Manage teacher accounts and class assignments</p>
    </div>

    <!-- Search Section -->
    <div class="bg-white rounded-lg shadow p-6 mb-6">
        <h2 class="text-lg font-semibold mb-4">Find Teacher</h2>
        <div class="flex gap-4">
            <input type="text" id="searchInput" placeholder="Enter Teacher ID or Email"
                   class="flex-1 px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
            <button onclick="findUser()" class="bg-blue-600 hover:bg-blue-700 text-white px-6 py-2 rounded-lg flex items-center">
                <i class="fas fa-search mr-2"></i> Find User
            </button>
            <button onclick="deleteUser()" class="bg-red-600 hover:bg-red-700 text-white px-6 py-2 rounded-lg flex items-center">
                <i class="fas fa-trash mr-2"></i> Delete User
            </button>
        </div>
    </div>

    <!-- Teacher Actions Section -->
    <div id="teacherActions" class="bg-white rounded-lg shadow p-6 mb-6 hidden">
        <h2 class="text-lg font-semibold mb-4">Teacher Actions</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
            <button onclick="showAssignModal()" class="bg-green-600 hover:bg-green-700 text-white px-4 py-3 rounded-lg flex items-center justify-center">
                <i class="fas fa-chalkboard-teacher mr-2"></i> Assign Teacher
            </button>
            <button onclick="showUnassignModal()" class="bg-yellow-600 hover:bg-yellow-700 text-white px-4 py-3 rounded-lg flex items-center justify-center">
                <i class="fas fa-times-circle mr-2"></i> Unassign Teacher
            </button>
            <button onclick="showEditModal()" class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-3 rounded-lg flex items-center justify-center">
                <i class="fas fa-edit mr-2"></i> Edit
            </button>
        </div>

        <!-- Teacher Info -->
        <div id="teacherInfo" class="border-t pt-4"></div>

        <!-- Assigned Classes -->
        <div id="assignedClasses" class="border-t pt-4 mt-4 hidden">
            <h3 class="text-md font-semibold mb-2">Assigned Classes</h3>
            <div id="classesList" class="space-y-2"></div>
        </div>
    </div>

    <!-- Teachers List -->
    <div class="bg-white rounded-lg shadow">
        <div class="px-6 py-4 border-b">
            <h2 class="text-lg font-semibold">All Teachers</h2>
        </div>
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200">
                <thead class="bg-gray-50">
                    <tr>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">ID</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Name</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Email</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
                    </tr>
                </thead>
                <tbody class="bg-white divide-y divide-gray-200">
                    @foreach (var teacher in Model.Users)
                    {
                        <tr>
                            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">@teacher.IdNumber</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">@teacher.FullName</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">@teacher.Email</td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full @(teacher.IsActive ? "bg-green-100 text-green-800" : "bg-red-100 text-red-800")">
                                    @(teacher.IsActive ? "Active" : "Inactive")
                                </span>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
                                <button onclick="loadTeacher('@teacher.IdNumber')" class="text-blue-600 hover:text-blue-900 mr-3">Select</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modals -->
<div id="assignModal" class="fixed inset-0 bg-gray-600 bg-opacity-50 overflow-y-auto h-full w-full hidden">
    <div class="relative top-20 mx-auto p-5 border w-96 shadow-lg rounded-md bg-white">
        <div class="mt-3">
            <h3 class="text-lg font-medium text-gray-900">Assign Teacher</h3>
            <div class="mt-2">
                <input type="text" id="assignEdpCode" placeholder="Enter EDP Code" class="w-full px-3 py-2 border border-gray-300 rounded-md">
            </div>
            <div class="flex justify-end space-x-3 mt-4">
                <button onclick="hideAssignModal()" class="px-4 py-2 bg-gray-300 text-gray-700 rounded-md">Cancel</button>
                <button onclick="assignTeacher()" class="px-4 py-2 bg-green-600 text-white rounded-md">Assign</button>
            </div>
        </div>
    </div>
</div>

<div id="unassignModal" class="fixed inset-0 bg-gray-600 bg-opacity-50 overflow-y-auto h-full w-full hidden">
    <div class="relative top-20 mx-auto p-5 border w-96 shadow-lg rounded-md bg-white">
        <div class="mt-3">
            <h3 class="text-lg font-medium text-gray-900">Unassign Teacher</h3>
            <div class="mt-2">
                <input type="text" id="unassignEdpCode" placeholder="Enter EDP Code" class="w-full px-3 py-2 border border-gray-300 rounded-md">
            </div>
            <div class="flex justify-end space-x-3 mt-4">
                <button onclick="hideUnassignModal()" class="px-4 py-2 bg-gray-300 text-gray-700 rounded-md">Cancel</button>
                <button onclick="unassignTeacher()" class="px-4 py-2 bg-yellow-600 text-white rounded-md">Unassign</button>
            </div>
        </div>
    </div>
</div>

<div id="editModal" class="fixed inset-0 bg-gray-600 bg-opacity-50 overflow-y-auto h-full w-full hidden">
    <div class="relative top-20 mx-auto p-5 border w-96 shadow-lg rounded-md bg-white">
        <div class="mt-3">
            <h3 class="text-lg font-medium text-gray-900">Edit Teacher</h3>
            <div class="mt-2 space-y-3">
                <div>
                    <label class="block text-sm font-medium text-gray-700">Email</label>
                    <input type="email" id="editEmail" class="w-full px-3 py-2 border border-gray-300 rounded-md">
                </div>
                <div class="flex items-center">
                    <input type="checkbox" id="editIsActive" class="h-4 w-4 text-blue-600 border-gray-300 rounded">
                    <label class="ml-2 block text-sm text-gray-900">Active</label>
                </div>
            </div>
            <div class="flex justify-end space-x-3 mt-4">
                <button onclick="hideEditModal()" class="px-4 py-2 bg-gray-300 text-gray-700 rounded-md">Cancel</button>
                <button onclick="updateTeacher()" class="px-4 py-2 bg-blue-600 text-white rounded-md">Update</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let currentUserId = 0;

        function findUser() {
            const searchTerm = document.getElementById('searchInput').value.trim();
            if (!searchTerm) {
                alert('Please enter a Teacher ID or Email');
                return;
            }

            fetch('@Url.Action("FindUser", "AccountManagement")?searchTerm=' + encodeURIComponent(searchTerm) + '&role=Teacher')
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        currentUserId = data.data.id; // primary key
                        displayUserInfo(data.data);
                        loadAssignedClasses();
                        showTeacherActions();
                    } else {
                        alert(data.message);
                        hideTeacherActions();
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    alert('Error searching for user');
                });
        }

        function loadTeacher(idNumber) {
            fetch('@Url.Action("FindUser", "AccountManagement")?searchTerm=' + idNumber + '&role=Teacher')
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        currentUserId = data.data.id;
                        displayUserInfo(data.data);
                        loadAssignedClasses();
                        showTeacherActions();
                        document.getElementById('searchInput').value = idNumber;
                    } else {
                        alert(data.message);
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    alert('Error loading teacher');
                });
        }

        function displayUserInfo(user) {
            const teacherInfo = document.getElementById('teacherInfo');
            teacherInfo.innerHTML = `
                <h3 class="text-md font-semibold mb-2">Teacher Information</h3>
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="text-sm text-gray-600">Teacher ID:</label>
                        <p class="font-medium">${user.idNumber}</p>
                    </div>
                    <div>
                        <label class="text-sm text-gray-600">Name:</label>
                        <p class="font-medium">${user.firstName} ${user.lastName}</p>
                    </div>
                    <div>
                        <label class="text-sm text-gray-600">Email:</label>
                        <p class="font-medium">${user.email}</p>
                    </div>
                    <div>
                        <label class="text-sm text-gray-600">Status:</label>
                        <p class="font-medium"><span class="px-2 py-1 rounded-full text-xs ${user.isActive ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800'}">${user.isActive ? 'Active' : 'Inactive'}</span></p>
                    </div>
                </div>
            `;
        }

        function loadAssignedClasses() {
            fetch('@Url.Action("GetAssignedClasses", "AccountManagement")?userId=' + currentUserId)
                .then(response => response.json())
                .then(data => {
                    const classesList = document.getElementById('classesList');
                    const assignedClasses = document.getElementById('assignedClasses');

                    if (data.success && data.data && data.data.length > 0) {
                        classesList.innerHTML = data.data.map(cls => `
                            <div class="flex justify-between items-center p-2 bg-gray-50 rounded">
                                <span class="font-medium">${cls.edpCode}</span>
                                <span class="text-sm text-gray-600">${cls.className}</span>
                            </div>
                        `).join('');
                        assignedClasses.classList.remove('hidden');
                    } else {
                        classesList.innerHTML = '<p class="text-gray-500">No assigned classes</p>';
                        assignedClasses.classList.remove('hidden');
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                });
        }

        function showTeacherActions() {
            document.getElementById('teacherActions').classList.remove('hidden');
        }

        function hideTeacherActions() {
            document.getElementById('teacherActions').classList.add('hidden');
        }

        // Modal Functions
        function showAssignModal() {
            document.getElementById('assignModal').classList.remove('hidden');
        }

        function hideAssignModal() {
            document.getElementById('assignModal').classList.add('hidden');
        }

        function showUnassignModal() {
            document.getElementById('unassignModal').classList.remove('hidden');
        }

        function hideUnassignModal() {
            document.getElementById('unassignModal').classList.add('hidden');
        }

        function showEditModal() {
            // Pre-fill current values
            fetch('@Url.Action("FindUser", "AccountManagement")?searchTerm=' + currentUserId + '&role=Teacher')
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        document.getElementById('editEmail').value = data.data.email;
                        document.getElementById('editIsActive').checked = data.data.isActive;
                        document.getElementById('editModal').classList.remove('hidden');
                    } else {
                        alert(data.message);
                    }
                });
        }

        function hideEditModal() {
            document.getElementById('editModal').classList.add('hidden');
        }

        // Action Functions
        function assignTeacher() {
            const edpCode = document.getElementById('assignEdpCode').value.trim();
            if (!edpCode) {
                alert('Please enter EDP Code');
                return;
            }

            fetch('@Url.Action("AssignTeacher", "AccountManagement")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                },
                body: JSON.stringify({ userId: currentUserId, edpCode: edpCode })
            })
            .then(response => response.json())
            .then(data => {
                alert(data.message);
                if (data.success) {
                    hideAssignModal();
                    loadAssignedClasses();
                    document.getElementById('assignEdpCode').value = '';
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert('Error assigning teacher');
            });
        }

        function unassignTeacher() {
            const edpCode = document.getElementById('unassignEdpCode').value.trim();
            if (!edpCode) {
                alert('Please enter EDP Code');
                return;
            }

            fetch('@Url.Action("UnassignTeacher", "AccountManagement")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                },
                body: JSON.stringify({ userId: currentUserId, edpCode: edpCode })
            })
            .then(response => response.json())
            .then(data => {
                alert(data.message);
                if (data.success) {
                    hideUnassignModal();
                    loadAssignedClasses();
                    document.getElementById('unassignEdpCode').value = '';
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert('Error unassigning teacher');
            });
        }

        function updateTeacher() {
            const email = document.getElementById('editEmail').value.trim();
            const isActive = document.getElementById('editIsActive').checked;

            if (!email) {
                alert('Please enter email address');
                return;
            }

            fetch('@Url.Action("EditUser", "AccountManagement")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                },
                body: JSON.stringify({ userId: currentUserId, email: email, isActive: isActive })
            })
            .then(response => response.json())
            .then(data => {
                alert(data.message);
                if (data.success) {
                    hideEditModal();
                    loadTeacher(currentUserId); // Reload user info
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert('Error updating teacher');
            });
        }

        function deleteUser() {
            if (!currentUserId) {
                alert('Please search for a user first');
                return;
            }

            if (!confirm('Are you sure you want to delete this user? This action cannot be undone.')) {
                return;
            }

            fetch('@Url.Action("DeleteUser", "AccountManagement")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                },
                body: JSON.stringify({ userId: currentUserId })
            })
            .then(response => response.json())
            .then(data => {
                alert(data.message);
                if (data.success) {
                    location.reload();
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert('Error deleting user');
            });
        }
    </script>
}